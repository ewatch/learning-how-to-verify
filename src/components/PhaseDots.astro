---
import type { Locale, PhaseId } from '../data/types';
import { PHASES } from '../data/taxonomy';
interface Props { phases: PhaseId[]; lang: Locale }
const { phases, lang } = Astro.props;
---
<span class="phases" aria-label={(lang === 'en' ? 'Lifecycle: ' : 'Lebenszyklus: ') + phases.map((id) => PHASES.find((x) => x.id === id)!.name[lang]).join(', ')}>
  {PHASES.map((ph) => <i class:list={{ on: phases.includes(ph.id) }} style={`--pc: var(--p-${ph.id})`} title={ph.name[lang]} />)}
</span>
<style>
  .phases { display: inline-flex; gap: 3px; }
  i { width: 18px; height: 4px; border-radius: 2px; background: var(--rule); display: block; }
  i.on { background: var(--pc); }
</style>
