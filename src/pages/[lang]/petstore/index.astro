---
import Base from '../../../layouts/Base.astro';
import PartChip from '../../../components/PartChip.astro';
import type { Locale } from '../../../data/types';
import { PARTS, PART_BY_ID, PETSTORE_COPY as C, KIND_ORDER, ZONE_ORDER, partAnchor, type PartId, type DomainPart } from '../../../data/petstore';
import { LAYERS } from '../../../data/taxonomy';
import { href, t } from '../../../i18n/ui';
import type { Practice } from '../../../data/types';
import { inline } from '../../../lib/inline';
import { langPaths } from '../../../lib/paths';
import { practicesFor, operationsFor } from '../../../lib/petstore';
export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Locale };
const of = (kind: DomainPart['kind']) => PARTS.filter((p) => p.kind === kind);
const count = (id: PartId) => practicesFor(id).length;
const sys = (id: PartId) => PART_BY_ID.get(id)!;
const zoneParts = (z: string) => PARTS.filter((p) => p.zone === z);
/** practices listed before the "more" disclosure */
const SHOWN = 6;
const layerName = (x: Practice) => LAYERS.find((l) => l.id === x.layer)!.name[lang];
---
<Base lang={lang} path="petstore/" md={`/${lang}/petstore/index.md`} title={C.title[lang]} description={C.description[lang]}>
  <div class="wrap">
    <header class="ps-head">
      <h1>{C.title[lang]}</h1>
      <p class="lede">{C.intro[lang]}</p>
      <p class="story">{C.story[lang]}</p>
    </header>

    <!-- the map: three zones; the running petstore in the middle holds the domain code with data, operations and rules -->
    <figure class="map" aria-label={C.mapLabel[lang]}>
      {ZONE_ORDER.map((z) => (
        <section class={`zone z-${z}`} aria-labelledby={`zone-${z}`}>
          <h2 class="zone-h" id={`zone-${z}`}>{C.zone[z][lang]}</h2>
          {z !== 'run' ? (
            <ul class="sys-list">
              {zoneParts(z).map((p) => (
                <li><a class="sys" href={`#${partAnchor(p.id)}`}><strong>{p.name[lang]}</strong><span class="n" title={C.count[lang]}>{count(p.id)}</span><span class="sys-t" set:html={inline(p.text[lang])} /></a></li>
              ))}
            </ul>
          ) : (
            <div class="run">
              <ol class="stack">
                {(['ui', 'api'] as PartId[]).map((id) => (
                  <li><a class="sys" href={`#${partAnchor(id)}`}><strong>{sys(id).name[lang]}</strong><span class="n" title={C.count[lang]}>{count(id)}</span></a></li>
                ))}
                <li class="domain">
                  <a class="sys dom-h" href={`#${partAnchor('domain')}`}><strong>{sys('domain').name[lang]}</strong><span class="n" title={C.count[lang]}>{count('domain')}</span></a>
                  {(['data', 'operation', 'rule'] as const).map((k) => (
                    <div class={`dom-row r-${k}`}>
                      <span class="dom-k">{C.kind[k][lang]}</span>
                      <span class="dom-chips">{of(k).map((p) => <PartChip id={p.id} lang={lang} local count={count(p.id)} />)}</span>
                    </div>
                  ))}
                </li>
                <li><a class="sys" href={`#${partAnchor('db')}`}><strong>{sys('db').name[lang]}</strong><span class="n" title={C.count[lang]}>{count('db')}</span></a></li>
              </ol>
              <a class="sys ext" href={`#${partAnchor('services')}`}><strong>{sys('services').name[lang]}</strong><span class="n" title={C.count[lang]}>{count('services')}</span></a>
            </div>
          )}
        </section>
      ))}
      <figcaption class="small muted">{C.mapHint[lang]}</figcaption>
    </figure>

    <h2 class="parts-h">{C.partsTitle[lang]}</h2>
    {KIND_ORDER.map((kind) => (
      <section class="kind" aria-labelledby={`kind-${kind}`}>
        <h3 id={`kind-${kind}`} class="eyebrow">{C.kind[kind][lang]}</h3>
        <div class="parts">
          {of(kind).map((p) => {
            const ps = practicesFor(p.id);
            const ops = p.kind === 'rule' ? operationsFor(p.id) : [];
            return (
              <article class={`part k-${p.kind}`} id={partAnchor(p.id)} tabindex="-1">
                <h4>{p.name[lang]}{p.zone && <span class="zone-tag">{C.zone[p.zone][lang]}</span>}</h4>
                <p set:html={inline(p.text[lang])} />
                {p.sig && <p class="sig"><code>{p.sig}</code></p>}
                {p.rules?.length ? <p class="rel"><span>{C.rulesLabel[lang]}:</span> {p.rules.map((r) => <PartChip id={r} lang={lang} local />)}</p> : null}
                {ops.length ? <p class="rel"><span>{C.kind.operation[lang]}:</span> {ops.map((o) => <PartChip id={o.id} lang={lang} local />)}</p> : null}
                <p class="used-h">{C.usedBy[lang]} ({ps.length})</p>
                {ps.length ? (
                  <ul class="used">{ps.slice(0, SHOWN).map((x) => <li style={`--c: var(--l-${x.layer})`}><a href={href(lang, `practices/${x.id}/`)} title={layerName(x)}>{x.name[lang]}</a><span class="what" set:html={inline(x.domain.what[lang])} /></li>)}</ul>
                ) : <p class="small muted">{C.usedByNone[lang]}</p>}
                {ps.length > SHOWN && (
                  <details class="more"><summary>{ps.length - SHOWN} {t(lang, 'moreN')}</summary><ul class="used">{ps.slice(SHOWN).map((x) => <li style={`--c: var(--l-${x.layer})`}><a href={href(lang, `practices/${x.id}/`)} title={layerName(x)}>{x.name[lang]}</a><span class="what" set:html={inline(x.domain.what[lang])} /></li>)}</ul></details>
                )}
              </article>
            );
          })}
        </div>
      </section>
    ))}
  </div>
</Base>

<style>
  .ps-head { max-width: 46rem; padding-bottom: 8px; }
  .story { display: flex; gap: 10px; align-items: baseline; margin: 0 0 22px; padding: 8px 12px; border-left: 4px solid var(--warn); background: var(--card); border-radius: 0 var(--radius) var(--radius) 0; font-size: var(--fs-ui); }
  .rex { flex: none; }

  /* map: three zones side by side on wide screens, stacked on phones */
  .map { margin: 0 0 40px; display: grid; gap: 12px; grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr) minmax(0, 1fr); align-items: stretch; }
  .map figcaption { grid-column: 1 / -1; }
  @media (max-width: 900px) { .map { grid-template-columns: minmax(0, 1fr); } }
  .zone { border: 1px solid var(--rule); border-radius: var(--radius); background: var(--paper-2); padding: 10px 12px 12px; min-width: 0; }
  .z-run { background: var(--card); border-color: var(--rule-strong); }
  .zone-h { font: 600 var(--fs-xs)/1.2 var(--font-body); letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); margin: 0 0 10px; }
  .sys-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .sys { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 8px; padding: 7px 10px; border: 1px solid var(--rule-strong); border-radius: 4px; background: var(--card); color: var(--ink); text-decoration: none; font-size: var(--fs-ui); }
  .sys:hover strong { text-decoration: underline; }
  .sys .n { margin-inline-start: auto; font-size: var(--fs-xs); color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .sys-t { flex-basis: 100%; font-size: var(--fs-sm); color: var(--ink-2); line-height: 1.4; }
  .run { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px; align-items: center; }
  @media (max-width: 560px) { .run { grid-template-columns: minmax(0, 1fr); } }
  .stack { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  /* arrows between the layers of a request */
  .stack > li { position: relative; }
  .stack > li + li::before { content: ''; position: absolute; left: 50%; top: -13px; height: 12px; border-left: 2px solid var(--rule-strong); }
  .stack > li + li::after { content: ''; position: absolute; left: calc(50% - 4px); top: -6px; border: 5px solid transparent; border-top-color: var(--rule-strong); border-bottom: 0; }
  .ext { position: relative; flex-direction: column; align-items: flex-start; border-style: dashed; max-width: 11rem; }
  /* a dashed line from the domain code to the external services */
  .ext::before { content: ''; position: absolute; right: 100%; top: 50%; width: 10px; border-top: 2px dashed var(--rule-strong); }
  .ext .n { margin-inline-start: 0; }
  @media (max-width: 560px) { .ext { max-width: none; flex-direction: row; } .ext .n { margin-inline-start: auto; } .ext::before { display: none; } }
  .domain { border: 2px solid var(--link); border-radius: var(--radius); padding: 0 10px 10px; background: color-mix(in srgb, var(--link) 5%, var(--card)); }
  .dom-h { border: 0; background: none; padding: 8px 0 6px; }
  .dom-row { display: grid; grid-template-columns: 6.5rem minmax(0, 1fr); gap: 6px; align-items: baseline; padding: 6px 0; border-top: 1px solid var(--rule); }
  .dom-k { font-size: var(--fs-xs); color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600; }
  .dom-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  @media (max-width: 560px) { .dom-row { grid-template-columns: minmax(0, 1fr); } }

  /* details */
  .parts-h { margin-top: 8px; }
  .kind { margin: 18px 0 30px; }
  .parts { display: grid; gap: 12px; align-items: start; grid-template-columns: repeat(auto-fill, minmax(min(100%, 330px), 1fr)); }
  .part { background: var(--card); border: 1px solid var(--rule); border-radius: var(--radius); padding: 14px 16px; scroll-margin-top: 5rem; min-width: 0; }
  .part.k-rule { border-left: 4px solid var(--warn); }
  .part.k-operation { border-left: 4px solid var(--link); }
  .part.k-data { border-style: dashed; }
  .part:target, .part:focus { outline: 3px solid var(--focus); outline-offset: 2px; }
  .part h4 { font-size: var(--fs-lg); margin: 0 0 6px; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; }
  .zone-tag { font: 400 var(--fs-xs)/1.2 var(--font-body); color: var(--ink-3); }
  .part p { margin: 0 0 8px; font-size: var(--fs-ui); }
  .sig code { font-size: var(--fs-code); overflow-wrap: anywhere; }
  .rel { display: flex; flex-wrap: wrap; gap: 4px 6px; align-items: center; }
  .rel > span { color: var(--ink-3); font-size: var(--fs-sm); }
  .used-h { font-weight: 700; font-size: var(--fs-sm) !important; margin: 10px 0 4px !important; }
  .used { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; font-size: var(--fs-sm); }
  .used li { padding-left: 10px; border-left: 3px solid var(--c); }
  .used a { font-weight: 600; }
  .used .what { display: block; color: var(--ink-2); line-height: 1.4; }
  .part .more { margin-top: 6px; font-size: var(--fs-sm); }
  .part .more .used { margin-top: 6px; }
</style>
