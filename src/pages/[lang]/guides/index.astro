---
import Base from '../../../layouts/Base.astro';
import { GUIDES_INDEX_COPY } from '../../../data/page-copy';
import type { Locale } from '../../../data/types';
import { GUIDES } from '../../../data/guides';
import { href } from '../../../i18n/ui';
import { langPaths } from '../../../lib/paths';
import { devMark } from '../../../lib/dev-mark';
export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Locale };
const en = lang === 'en';
const planned = ['Lean 4', 'Z3', 'fast-check / Hypothesis', 'Stryker / mutmut', 'Jazzer.js / Atheris', 'typescript-eslint / Ruff', 'Semgrep'];
---
<Base lang={lang} path="guides/" md={`/${lang}/guides/index.md`} nav="guides" title={en ? 'Getting-started guides' : 'Einstiegsanleitungen'} description={en ? 'Step-by-step guides for verification tools, with real recorded output.' : 'Schritt-für-Schritt-Anleitungen für Verifikationswerkzeuge, mit echter aufgezeichneter Ausgabe.'}>
  <div class="wrap narrow">
    <header {...devMark('tighter lede')}>
      <h1>{en ? 'Getting started' : 'Einstieg'}</h1>
      <p class="lede">{GUIDES_INDEX_COPY.intro[lang]}</p>
    </header>
    <div class="grid">
      {GUIDES.map((g) => <a class="card g" href={href(lang, `guides/${g.id}/`)}><strong>{g.title[lang]}</strong><span>{g.outcome[lang]}</span></a>)}
    </div>
    <h2 class="later">{en ? 'Coming next' : 'Als Nächstes'}</h2>
    <p class="muted">{planned.join(' · ')}</p>
  </div>
</Base>
<style>
  .g { display: flex; flex-direction: column; gap: 6px; text-decoration: none; color: var(--ink); }
  .g span { color: var(--ink-2); font-size: var(--fs-ui); }
  .g:hover { border-color: var(--rule-strong); }
  .later { margin-top: 36px; font-size: var(--fs-lg); }
</style>
