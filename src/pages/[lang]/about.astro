---
import Base from '../../layouts/Base.astro';
import { ABOUT_COPY } from '../../data/page-copy';
import type { Locale } from '../../data/types';
import { SOURCES } from '../../data/sources';
import { TOOLS } from '../../data/tools';
import { PRACTICES } from '../../data/practices';
import { inline } from '../../lib/inline';
import { langPaths } from '../../lib/paths';
import { t, href } from '../../i18n/ui';
export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Locale };
const en = lang === 'en';
const sorted = [...SOURCES].sort((a, b) => a.authors.localeCompare(b.authors));
---
<Base lang={lang} path="about/" md={`/${lang}/about/index.md`} nav="about" title={en ? 'About' : 'Über'} description={ABOUT_COPY.description[lang]}>
  <div class="wrap narrow">
    <h1>{en ? 'About this site' : 'Über diese Seite'}</h1>

    <section>
      <h2>{en ? 'Credits' : 'Quellen der Ideen'}</h2>
      <ul>
        <li>{en ? 'Funnel (codebase → static analysis → verification → prose → review): ' : 'Trichter (Codebasis → statische Analyse → Verifikation → Prosa → Review): '}<strong>Lauren Tan (@poteto)</strong> (<a href={href(lang, 'references/#lauren-tan-talk')}>{en ? 'talk' : 'Vortrag'}</a>).</li>
        <li>{en ? 'Lifecycle overview (pre-production to post-release): ' : 'Lebenszyklus-Übersicht (vor Produktion bis nach Release): '}<strong>Cindy Sridharan (@copyconstruct)</strong>.</li>
        <li>{ABOUT_COPY.diagrams[lang]} {en ? 'See ' : 'Siehe '}<a href={href(lang, 'references/')}>{t(lang, 'navReferences')}</a>.</li>
      </ul>
    </section>

    <section>
      <h2 id="self-verification">{en ? 'How this site verifies itself' : 'Wie diese Seite sich selbst prüft'}</h2>
      <p>{ABOUT_COPY.checksIntro[lang]}</p>
      <ul>
        {ABOUT_COPY.checks(PRACTICES.length, TOOLS.length).map((check) => <li set:html={inline(check[lang])} />)}
      </ul>
    </section>

    <section>
      <h2>{en ? 'Privacy' : 'Datenschutz'}</h2>
      <p>{ABOUT_COPY.privacy[lang]}</p>
    </section>

    <h2 id="sources">{en ? 'All sources' : 'Alle Quellen'} ({SOURCES.length})</h2>
    <p class="muted small">{ABOUT_COPY.sourcesNote[lang]}</p>
    <ol class="sources">
      {sorted.map((s) => <li id={`src-${s.id}`}>{s.authors}. <a href={s.url} rel="noopener">{s.title}</a>. <em>{s.venue}</em>, {s.year}.{s.preprint && <span class="badge">{t(lang, 'preprint')}</span>}</li>)}
    </ol>
  </div>
</Base>
<style>
  h2 { margin-top: 2rem; scroll-margin-top: 5rem; }
  .sources { font-size: var(--fs-ui); }
  .sources li { margin-bottom: .5em; }
</style>
