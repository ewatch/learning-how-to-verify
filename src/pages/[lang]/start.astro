---
import Base from '../../layouts/Base.astro';
import type { Locale } from '../../data/types';
import { PRACTICE_BY_ID } from '../../data/practices';
import { START_COPY as C, START_TOUR, DIAGNOSE_COPY } from '../../data/start';
import { GUIDE_BY_ID } from '../../data/guides';
import { href, t } from '../../i18n/ui';
import { langPaths } from '../../lib/paths';
export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Locale };
const steps = START_TOUR.map((step) => {
  const p = step.practice ? PRACTICE_BY_ID.get(step.practice)! : undefined;
  return {
    id: step.id,
    url: p ? href(lang, `practices/${p.id}/`) : href(lang, step.path),
    name: p ? p.name[lang] : step.title![lang],
    exercise: step.exercise[lang],
    sim: Boolean(p?.sim),
  };
});
---
<Base lang={lang} path="start/" nav="start" title={C.title[lang]} description={C.description[lang]} md={`/${lang}/start/index.md`}>
  <article class="wrap start" data-tour data-resume={C.resume[lang]} data-review={C.allOpened[lang]} data-progress={C.progress[lang]}
    data-states={JSON.stringify({ done: C.stateDone[lang], opened: C.stateOpened[lang], current: C.stateCurrent[lang] })}>
    <header class="intro">
      <h1>{C.title[lang]}</h1>
      <p class="lede">{C.intro[lang]}</p>
      <div class="facts">
        <div>
          <h2 class="eyebrow">{C.after[lang]}</h2>
          <ul class="outcomes">{C.outcomes.map((o) => <li>{o[lang]}</li>)}</ul>
        </div>
        <div>
          <h2 class="eyebrow">{C.timeLabel[lang]}</h2>
          <p class="time">{C.time[lang]}</p>
        </div>
      </div>
      <div class="begin">
        <a class="btn primary" href={steps[0].url} data-tour-begin data-step={steps[0].id}>{C.begin[lang]} →</a>
        <p class="finished" role="status" data-tour-finished hidden>{C.finished[lang].replaceAll('{total}', String(steps.length))}</p>
        <p class="small muted progress" data-tour-status hidden>
          <span data-tour-count></span>
          <button type="button" class="linkish" data-tour-reset>{C.reset[lang]}</button>
        </p>
      </div>
    </header>

    <aside class="example card" aria-labelledby="example">
      <h2 id="example" class="eyebrow">{C.example[lang]}</h2>
      <p class="ex-text">{C.exampleText[lang]} <strong>{C.rule[lang]}</strong></p>
      <ol class="ex-run" aria-label={C.rule[lang]}>
        <li class="ok"><code>reserve(rex, anna)</code><span class="arrow" aria-hidden="true">→</span><span class="res"><span aria-hidden="true">✓</span> {C.reservedFor[lang]}</span></li>
        <li class="bad"><code>reserve(rex, ben)</code><span class="arrow" aria-hidden="true">→</span><span class="res"><span aria-hidden="true">✗</span> {C.rejected[lang]}</span></li>
      </ol>
      <p class="small muted fee">{C.fee[lang]}</p>
      <p class="petstore"><a href={href(lang, 'petstore/')}>{C.petstore[lang]} <span aria-hidden="true">→</span></a></p>
    </aside>

    <section class="tour" aria-labelledby="tour">
      <h2 id="tour">{C.learn[lang]}</h2>
      <ol class="path">
        {steps.map((s, i) => <li data-step={s.id}>
          <a href={s.url} data-step={s.id}>
            <span class="n" aria-hidden="true"><span class="num">{i + 1}</span><span class="tick">✓</span></span>
            <span class="body">
              <strong><span class="visually-hidden">{i + 1}. </span>{s.name}</strong>
              <span class="why">{s.exercise}</span>
              {s.sim && <span class="tag simtag">{C.sim[lang]}</span>}
              <span class="state visually-hidden" data-step-state hidden></span>
            </span>
          </a>
        </li>)}
      </ol>
    </section>

    <section class="next-block" aria-labelledby="what-next">
      <h2 id="what-next">{C.whatNext[lang]}</h2>
      <div class="next-grid">
        <div class="card diag">
          <h3>{C.diagnose[lang]}</h3>
          <p>{C.diagnoseHint[lang]}</p>
          <a class="btn ghost" href={href(lang, 'diagnose/')}>{DIAGNOSE_COPY.title[lang]} →</a>
        </div>
        <div class="setup">
          <h3>{C.guides[lang]}</h3>
          <p class="muted">{C.guidesHint[lang]}</p>
          <ul class="setup-links">
            {['tla', 'dafny'].map((id) => <li><a href={href(lang, `guides/${id}/`)}>{GUIDE_BY_ID.get(id)!.title[lang]} →</a></li>)}
            <li><a href={href(lang, 'stack/')}>{t(lang, 'navStack')} →</a></li>
          </ul>
        </div>
      </div>
    </section>
  </article>
</Base>
<script>
  import { PROGRESS_KEY, parseTour, serializeTour, emptyTour, enterStep, firstNotDone, stepStatuses, fill, type TourState } from '../../lib/start-progress';
  const root = document.querySelector<HTMLElement>('[data-tour]');
  if (root) {
    const items = [...root.querySelectorAll<HTMLLIElement>('.path > li')];
    const ids = items.map((li) => li.dataset.step!);
    const states = JSON.parse(root.dataset.states!) as Record<string, string>;
    const begin = root.querySelector<HTMLAnchorElement>('[data-tour-begin]')!;
    const beginText = begin.textContent;
    const status = root.querySelector<HTMLElement>('[data-tour-status]')!;
    const finished = root.querySelector<HTMLElement>('[data-tour-finished]')!;
    const read = (): TourState => { try { return parseTour(localStorage.getItem(PROGRESS_KEY), ids); } catch { return emptyTour(); } };
    const write = (s: TourState) => { try { localStorage.setItem(PROGRESS_KEY, serializeTour(s, ids)); } catch { /* storage unavailable */ } };
    const render = () => {
      const state = read();
      const statuses = stepStatuses(state, ids);
      const next = firstNotDone(state, ids);
      const started = state.opened.size > 0;
      items.forEach((li, i) => {
        li.dataset.state = started ? statuses[i] : 'open';
        const label = li.querySelector<HTMLElement>('[data-step-state]')!;
        const text = started ? states[statuses[i]] : undefined;
        label.hidden = !text;
        label.textContent = text ? ` (${text})` : '';
      });
      const target = next === -1 ? 0 : next;
      const link = items[target].querySelector('a')!;
      begin.href = link.href;
      begin.dataset.step = ids[target];
      begin.textContent = !started ? beginText : `${next === -1 ? root.dataset.review : fill(root.dataset.resume!, { n: target + 1 })} →`;
      status.hidden = !started;
      finished.hidden = next !== -1;
      root.querySelector('[data-tour-count]')!.textContent = fill(root.dataset.progress!, { n: state.done.size, opened: state.opened.size, total: ids.length });
    };
    // Entering a step from this page turns the tour on: the bar at the bottom then guides through each step page.
    const enter = (event: Event) => {
      const id = (event.target as Element).closest<HTMLElement>('a[data-step]')?.dataset.step;
      if (id) write(enterStep(read(), id));
    };
    root.addEventListener('click', enter);
    root.addEventListener('auxclick', enter);
    root.querySelector('[data-tour-reset]')!.addEventListener('click', () => {
      try { localStorage.removeItem(PROGRESS_KEY); } catch { /* storage unavailable */ }
      render();
      begin.focus();
    });
    // Back/forward cache and other tabs: show the current state when the page is shown again.
    addEventListener('pageshow', render);
    addEventListener('storage', (e) => { if (e.key === PROGRESS_KEY || e.key === null) render(); });
    render();
  }
</script>
<style>
  .start { max-width: 65rem; }
  .intro { margin-bottom: 28px; }
  .intro .lede { margin-bottom: 24px; }
  .facts { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: 16px 40px; max-width: 56rem; }
  .facts h2 { margin: 0 0 8px; }
  .outcomes { margin: 0; padding-left: 1.2em; color: var(--ink-2); }
  .outcomes li { margin: 0 0 4px; }
  .time { margin: 0; color: var(--ink-2); }
  .begin { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 20px; margin-top: 24px; }
  .btn.primary { font-size: var(--fs-body); padding: 11px 18px; font-weight: 600; }
  .progress { margin: 0; display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: baseline; }
  .progress[hidden] { display: none; }
  .linkish { background: none; border: 0; padding: 0; font: inherit; color: var(--link); text-decoration: underline; cursor: pointer; }

  .example { max-width: 44rem; margin: 0 0 32px; }
  .example h2 { margin: 0 0 8px; }
  .ex-text { margin: 0 0 12px; }
  .ex-run { list-style: none; padding: 0; margin: 0 0 10px; display: grid; gap: 6px; }
  .ex-run li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; margin: 0; }
  .ex-run code { font-size: var(--fs-code); }
  .ex-run .arrow { color: var(--ink-3); }
  .ex-run .ok .res { color: var(--ok); font-weight: 600; }
  .ex-run .bad .res { color: var(--bad); font-weight: 600; }
  .fee { margin: 0; }

  .tour { padding: 28px 0; border-top: 1px solid var(--rule); }
  .path { list-style: none; padding: 0; margin: 20px 0 0; display: grid; position: relative; max-width: var(--measure); }
  .path::before { content: ''; position: absolute; left: 17px; top: 18px; bottom: 18px; width: 2px; background: var(--rule-strong); }
  .path li { margin: 0; }
  .path a { display: flex; gap: 16px; padding: 12px 8px 12px 0; text-decoration: none; color: var(--ink); align-items: flex-start; position: relative; border-radius: var(--radius); }
  .n { flex: none; width: 36px; height: 36px; border-radius: 50%; background: var(--card); border: 2px solid var(--ink); display: grid; place-items: center; font: 700 var(--fs-ui) var(--font-mono); }
  .n .tick { display: none; }
  .path a:hover .n { background: var(--ink); color: var(--paper); }
  .path a:hover strong { text-decoration: underline; }
  .body { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; padding-top: 5px; min-width: 0; }
  .why { color: var(--ink-2); font-size: var(--fs-ui); }
  .simtag { margin-top: 4px; }
  .state[hidden] { display: none; }
  li[data-state='done'] .n { background: var(--ok); border-color: var(--ok); color: var(--paper); }
  li[data-state='done'] .n .num { display: none; }
  li[data-state='done'] .n .tick { display: inline; }
  li[data-state='opened'] .n { border-color: var(--ok); border-style: dashed; }
  li[data-state='current'] .n { box-shadow: 0 0 0 4px color-mix(in srgb, var(--l-static) 30%, transparent); border-color: var(--l-static); }
  li[data-state='current'] strong { color: var(--l-static); }
  .finished { flex-basis: 100%; margin: 0; padding: 10px 14px; border: 1px solid color-mix(in srgb, var(--ok) 45%, var(--rule)); background: color-mix(in srgb, var(--ok) 7%, var(--card)); border-radius: var(--radius); font-weight: 600; max-width: 40rem; }
  .finished[hidden] { display: none; }
  .petstore { margin: 10px 0 0; }

  .next-block { padding: 28px 0; border-top: 1px solid var(--rule); }
  .next-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 40px; align-items: start; margin-top: 16px; }
  .next-grid h3 { margin-top: 0; font-size: var(--fs-lg); }
  .diag p { color: var(--ink-2); }
  .setup-links { display: flex; flex-wrap: wrap; gap: 8px 24px; list-style: none; padding: 0; margin: 0; }
  .setup-links li { margin: 0; }
  @media (max-width: 650px) {
    .facts, .next-grid { grid-template-columns: 1fr; }
  }
</style>
