---
import Base from '../../../../layouts/Base.astro';
import WhereItSits from '../../../../components/WhereItSits.astro';
import Evidence from '../../../../components/Evidence.astro';
import LangTabs from '../../../../components/LangTabs.astro';
import VizMount from '../../../../components/VizMount.astro';
import SimMount from '../../../../components/SimMount.astro';
import PracticeCard from '../../../../components/PracticeCard.astro';
import type { Locale, Practice } from '../../../../data/types';
import { PRACTICES, PRACTICE_BY_ID } from '../../../../data/practices';
import { IN_USE } from '../../../../data/in-use';
import { GUIDE_BY_ID } from '../../../../data/guides';
import { LAYERS } from '../../../../data/taxonomy';
import { t, href } from '../../../../i18n/ui';
import { BASE } from '../../../../lib/site';
import { inline } from '../../../../lib/inline';
import { glosser } from '../../../../lib/gloss';
import { practiceMarkdown } from '../../../../lib/markdown';
import { socraticPrompt } from '../../../../lib/prompts';
import { PETSTORE_COPY } from '../../../../data/petstore';
import { devMark } from '../../../../lib/dev-mark';

export function getStaticPaths() {
  return (['en', 'de'] as Locale[]).flatMap((lang) => PRACTICES.map((p) => ({ params: { lang, id: p.id }, props: { lang, p } })));
}
const { lang, p } = Astro.props as { lang: Locale; p: Practice };
const layerIdx = LAYERS.findIndex((l) => l.id === p.layer);
const layer = LAYERS[layerIdx]!;
// PRACTICES is sorted by funnel layer, so the pager walks the funnel from codebase to review
const idx = PRACTICES.indexOf(p);
const prev = PRACTICES[idx - 1], next = PRACTICES[idx + 1];
const socratic = socraticPrompt(p, lang, 'js', practiceMarkdown(p, lang)).replace('JavaScript / TypeScript', '__PROGLANG__');
const gl = glosser(lang); // first occurrence of each glossary term per page
const thinkMore = p.think.slice(1);
// phones only: the petstore sentence of the strip, shown under the first heading
const psWhat = `<strong>${PETSTORE_COPY.inPetstore[lang]}:</strong> ${inline(p.domain.what[lang])}`;
const TIGHTENED_PROSE = new Set([
  'e2e-tests', 'test-integrity', 'agent-rules', 'formal-verification',
  'property-based-tests', 'ci', 'threat-modeling', 'differential-testing',
  'architecture', 'security-scanning', 'code-review', 'auditing',
]);
const proseTightened = TIGHTENED_PROSE.has(p.id);
let n = 0;
const num = () => String(++n).padStart(2, '0');
---
<Base lang={lang} path={`practices/${p.id}/`} md={`/${lang}/practices/${p.id}/index.md`} title={p.name[lang]} description={p.oneLiner[lang]}>
  <article class="wrap practice" style={`--c: var(--l-${p.layer})`}>
    <nav class="breadcrumb small" aria-label={t(lang, 'breadcrumb')}>
      <ol>
        <li><a href={href(lang)}>{t(lang, 'navFunnel')}</a></li>
        <li><a href={href(lang, `#layer-${p.layer}`)}>{layer.name[lang]}</a></li>
        <li><a href={href(lang, `practices/${p.id}/`)} aria-current="page">{p.name[lang]}</a></li>
      </ol>
    </nav>

    <header class="head" {...devMark(proseTightened ? 'dropped eyebrow + tighter intro' : 'dropped layer eyebrow')}>
      <h1>{p.name[lang]}</h1>
      <p class="intro" set:html={gl(p.intro[lang])} />
      <dl class="def">
        <div><dt>{t(lang, 'inOneSentence')}</dt><dd set:html={gl(p.oneLiner[lang])} /></div>
        <div><dt>{t(lang, 'catches')}</dt><dd set:html={gl(p.catches[lang])} /></div>
      </dl>
      <WhereItSits p={p} lang={lang} />
    </header>

    <nav class="toc" aria-label={t(lang, 'onThisPage')}>
      <a href={p.sim ? '#try' : p.viz ? '#see' : '#worth'}>{p.sim ? t(lang, 'tryIt') : p.viz ? t(lang, 'seeIt') : t(lang, 'strengthsLimits')}</a>
      {(p.sim || p.viz) && <a href="#worth">{t(lang, 'strengthsLimits')}</a>}
      <a href="#evidence">{t(lang, 'evidence')}</a>
      <a href="#setup">{t(lang, 'setUp')}</a>
      <a href="#deeper">{t(lang, 'goDeeper')}</a>
    </nav>

    {!p.sim && p.viz && (
      <section class="layer-section" id="see"><h2><span class="num">{num()}</span>{t(lang, 'seeIt')}</h2>
        <p class="ps-what-m small" set:html={psWhat} />
        <VizMount kind={p.viz.kind} mode={p.viz.mode} lang={lang} />
      </section>
    )}

    {p.sim && (
      <section class="layer-section" id="try" {...devMark('dropped tryItHint')}><h2><span class="num">{num()}</span>{t(lang, 'tryIt')}</h2>
        <p class="ps-what-m small" set:html={psWhat} />
        <SimMount sim={p.sim} lang={lang} />
      </section>
    )}

    <section class="layer-section" id="worth" {...(proseTightened ? devMark('tighter strengths/limits/AI') : {})}><h2><span class="num">{num()}</span>{t(lang, 'strengthsLimits')}</h2>
      <div class="grid cols-2">
        <div><h3>{t(lang, 'strengths')}</h3><ul class="checks">{p.worth.map((x) => <li set:html={gl(x[lang])} />)}</ul></div>
        <div><h3>{t(lang, 'limits')}</h3><ul class="limits">{p.limits.map((x) => <li set:html={gl(x[lang])} />)}</ul></div>
      </div>
      <aside class="ai" aria-labelledby="ai-h">
        <p class="ai-label" id="ai-h"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="8" width="14" height="11" rx="2" /><path d="M12 4v4M9 13h.01M15 13h.01M9 16h6" /></svg>{t(lang, 'withAgents')}</p>
        <p class="ai-text" set:html={gl(p.ai[lang])} />
      </aside>
    </section>

    <section class="layer-section" id="evidence" {...devMark('dropped evidenceLead')}><h2><span class="num">{num()}</span>{t(lang, 'evidence')}</h2>
      <Evidence general={p.evidence.general} ai={p.evidence.ai} lang={lang} inUse={IN_USE[p.id]} gl={gl} />
    </section>

    <section class="layer-section" id="setup"><h2><span class="num">{num()}</span>{t(lang, 'setUp')}</h2>
      <LangTabs p={p} lang={lang} socratic={socratic} />
    </section>

    <section class="layer-section" id="deeper" {...devMark('dropped CardKey legend')}><h2><span class="num">{num()}</span>{t(lang, 'goDeeper')}</h2>
      <h3>{t(lang, 'thinkFirst')}</h3>
      <div class="think">
        {p.think.slice(0, 1).map((q) => (
          <details class="disclose"><summary><span set:html={inline(q.q[lang])} /></summary><div class="body"><p set:html={gl(q.a[lang])} /></div></details>
        ))}
        {thinkMore.length > 0 && (
          <details class="more"><summary>{thinkMore.length} {t(lang, 'moreQuestions')}</summary>
            <div class="think">
              {thinkMore.map((q) => (
                <details class="disclose"><summary><span set:html={inline(q.q[lang])} /></summary><div class="body"><p set:html={gl(q.a[lang])} /></div></details>
              ))}
            </div>
          </details>
        )}
      </div>
      {p.variants?.length ? (
        <details class="disclose variants"><summary>{t(lang, 'variants')} ({p.variants.length})</summary>
          <div class="body"><dl>{p.variants.map((v) => <><dt>{v.name[lang]}</dt><dd set:html={gl(v.text[lang])} /></>)}</dl></div>
        </details>
      ) : null}
      {p.guides?.length ? (
        <><h3>{t(lang, 'guides')}</h3>
        <ul>{p.guides.map((g) => <li><a href={href(lang, `guides/${g}/`)}>{GUIDE_BY_ID.get(g)!.title[lang]}</a></li>)}</ul></>
      ) : null}
      <h3>{t(lang, 'related')}</h3>
      <div class="grid cols-3">{p.related.map((id) => <PracticeCard p={PRACTICE_BY_ID.get(id)!} lang={lang} compact />)}</div>
      <p class="origin small muted">{t(lang, 'origin')}: {p.fromOverview ? t(lang, 'fromOverview') : t(lang, 'addedHere')} (<a href={href(lang, 'lifecycle/')}>{t(lang, 'navLifecycle')}</a>)</p>
    </section>

    <nav class="pager" aria-label={t(lang, 'pagerLabel')}>
      {prev ? <a href={href(lang, `practices/${prev.id}/`)} rel="prev" data-nav="backward"><span class="pl small muted">← {t(lang, 'prevInFunnel')}</span><span class="nm">{prev.name[lang]}</span></a> : <span />}
      {next ? <a href={href(lang, `practices/${next.id}/`)} rel="next" data-nav="forward" class="nx"><span class="pl small muted">{t(lang, 'nextInFunnel')} →</span><span class="nm">{next.name[lang]}</span></a> : <span />}
    </nav>
  </article>
  <script is:inline src={`${BASE}/gloss.js`} defer></script>
</Base>

<style is:inline>
  /* kept out of the CSS pipeline: its minifier does not know anchored container queries yet */
  /* the arrow follows the fallback that is in use */
  @supports (container-type: anchored) {
    .gloss-pop[popover] { container-type: anchored; }
    .gloss-pop[popover]::before { content: ''; position: absolute; inset-block-start: -6px; inset-inline-start: 14px; inline-size: 10px; block-size: 10px; background: var(--card); border: solid var(--rule); border-width: 1px 0 0 1px; rotate: 45deg; }
    @container anchored(fallback: flip-block) { .gloss-pop[popover]::before { inset-block-start: auto; inset-block-end: -6px; border-width: 0 1px 1px 0; } }
  }
</style>
<style is:global>
  a.gloss { text-decoration: underline dotted; text-decoration-thickness: 1.5px; color: inherit; }
  a.gloss:hover, a.gloss:focus-visible { color: var(--link); }
  .gloss-pop { position: fixed; z-index: 50; box-sizing: border-box; padding: 10px 12px; background: var(--card); color: var(--ink); border: 1px solid var(--rule); border-radius: var(--radius); box-shadow: 0 6px 20px rgb(0 0 0 / 0.18); font-size: var(--fs-sm); line-height: 1.45; font-weight: 400; text-align: left; overflow: visible; }
  .gloss-pop:not([popover]) { display: block; }
  .gloss-pop[hidden] { display: none; }
  .gloss-pop[popover] { margin: 0; }
  .gloss-pop[popover]:popover-open { display: block; }
  /* anchored to the link (set by gloss.js as --gloss), flips above when there is no room below */
  @supports (top: anchor(bottom)) {
    .gloss-pop[popover] { --w: min(20rem, calc(100dvw - 1rem)); inline-size: var(--w); position-anchor: --gloss; inset: auto; top: anchor(bottom); left: max(0.5rem, min(anchor(left), calc(100dvw - var(--w) - 0.5rem))); margin-block: 8px; position-try-fallbacks: flip-block; }
  }
  .gloss-pop strong { display: block; margin-bottom: 2px; }
  .gloss-pop .gloss-def { display: block; color: var(--ink-2); margin-bottom: 6px; }
</style>
<style>
  .head { padding-bottom: 14px; }
  /* the strip may use the full width, so the petstore line stays on one line */
  .head > :not(.strip) { max-width: 58rem; }
  /* why first (a concrete problem), then the definition and the bug class as a compact block */
  .head .intro { max-width: 42rem; margin: 0 0 12px; font-size: var(--fs-body); line-height: 1.55; color: var(--ink); }
  /* the two definitions: small label above, same pattern as the facts strip below */
  .def { margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: 14px 40px; font-size: var(--fs-ui); line-height: 1.5; color: var(--ink-2); max-width: 58rem; }
  .def dt { margin-bottom: 3px; font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: .08em; font-weight: 600; color: var(--ink-3); }
  .def dd { margin: 0; color: var(--ink); }
  .toc { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 22px; margin: 4px 0 8px; padding: 10px 0; font-size: var(--fs-sm); border-block: 1px solid var(--rule); }
  .toc a { color: var(--ink-2); text-decoration: none; padding-block: 2px; }
  .toc a:hover, .toc a:focus-visible { color: var(--ink); text-decoration: underline; }
  .head h1 { border-left: 6px solid var(--c); padding-left: 14px; margin-left: -20px; }
  @media (max-width: 760px) { .head h1 { margin-left: 0; } }
  /* phones: keep "Try it" / "See it" on the first screen */
  @media (max-width: 560px) {
    .head h1 { margin-bottom: 10px; }
    .head .intro { font-size: var(--fs-ui); line-height: 1.5; margin-bottom: 10px; }
    .def { font-size: var(--fs-sm); line-height: 1.45; gap: 10px; }
    .toc { gap: 4px 16px; padding-block: 8px; }
    .head { padding-bottom: 12px; }
  }
  .ps-what-m { display: none; margin: -4px 0 6px; color: var(--ink-2); }
  @media (max-width: 560px) { .ps-what-m { display: block; } }
  ul.checks li::marker { content: '✓  '; color: var(--ok); }
  ul.limits li::marker { content: '–  '; color: var(--ink-3); }
  .ai { margin: 16px 0; padding: 10px 14px; border-left: 4px solid var(--c); background: color-mix(in srgb, var(--c) 7%, var(--card)); border-radius: var(--radius); }
  .ai-label { display: flex; align-items: center; gap: 8px; margin: 0 0 4px; font-weight: 700; font-size: var(--fs-ui); color: var(--ink); }
  .ai-label svg { color: var(--c); flex: none; }
  .ai-text { margin: 0; font-size: var(--fs-ui); }
  .more .think { margin: 6px 0 0; }
  .variants { margin: 0 0 20px; }
  .variants dt { font-weight: 700; margin-top: 8px; }
  .variants dd { margin: 2px 0 0; color: var(--ink-2); }
  .origin { margin: 26px 0 0; }
  .think { display: grid; gap: 8px; margin-bottom: 20px; }
  .think .disclose > summary { font-weight: 600; }
  /* below the fold: skip layout/paint until near the viewport (still found by Ctrl+F, anchors keep working) */
  #evidence, #setup, #deeper { content-visibility: auto; contain-intrinsic-size: auto none auto 42rem; }
  .pager a { display: inline-flex; flex-direction: column; gap: 2px; padding-block: 6px; }
  .pager .nx { text-align: end; align-items: flex-end; margin-inline-start: auto; }
  .pager a { text-decoration: none; }
  .pager .nm { text-decoration: underline; }
  .pager { display: flex; justify-content: space-between; gap: 12px; padding-top: 26px; border-top: 1px solid var(--rule); flex-wrap: wrap; }
</style>
