---
import type { Locale, Practice } from '../data/types';
import { HOME } from '../data/home';
import { LAYERS } from '../data/taxonomy';
import { PRACTICES } from '../data/practices';
import { t, href } from '../i18n/ui';
import PracticeCard from './PracticeCard.astro';
import CardKey from './CardKey.astro';

interface Props { lang: Locale }
const { lang } = Astro.props;
const en = lang === 'en';

/** Panels with more practices than this show the core ones first and fold the rest. */
const FOLD_ABOVE = 6;

const byLayer = (id: string) => PRACTICES.filter((p) => p.layer === id);
const countLabel = (n: number) => `${n} ${t(lang, 'practices')}`;

// geometry: inverted funnel, cheap/early at the top, expensive at the bottom.
// Two drawings from one function: `wide` (axis label in a left gutter) and `narrow` for small containers
// (no gutter, gentler taper, taller bands, so the names stay readable instead of shrinking with the figure).
// Each name gets the largest size up to `name` that fits its band where the band is narrowest under the text.
const EM_PER_CHAR = 0.56; // Fraunces 650, measured ~0.50–0.55 em per character; rounded up so estimates err on fitting
const W = 800, TOP = 8, MID = W / 2, PAD = 14;
const funnel = (g: { wide: number; narrow: number; band: number; name: number; small: number; count: number; nameY: number; countY: number }) => {
  const H = TOP + g.band * 5 + 8;
  const hw = (y: number) => g.wide - (g.wide - g.narrow) * ((y - TOP) / (g.band * 5));
  const bands = LAYERS.map((layer, i) => {
    const y0 = TOP + i * g.band, y1 = y0 + g.band;
    const a = hw(y0), b = hw(y1);
    const name = layer.name[lang];
    const room = 2 * (hw(y0 + g.nameY + 2) - PAD);
    const size = Math.min(i >= 3 ? g.small : g.name, Math.floor(room / (name.length * EM_PER_CHAR)));
    return { layer, i, y0, name, size, d: `M${MID - a} ${y0} L${MID + a} ${y0} L${MID + b} ${y1} L${MID - b} ${y1} Z`, count: byLayer(layer.id).length };
  });
  return { H, bands, g };
};
const wide = funnel({ wide: 384, narrow: 110, band: 78, name: 30, small: 26, count: 23, nameY: 40, countY: 67 });
const narrow = funnel({ wide: 392, narrow: 230, band: 92, name: 40, small: 40, count: 32, nameY: 44, countY: 80 });
const bands = wide.bands; // the chooser list and panels use the same order and counts
const costLabel = en ? 'cost of a missed bug' : 'Kosten eines übersehenen Fehlers';
const svgLabel = en ? 'Verification funnel' : 'Verifikationstrichter';

const split = (list: Practice[]) => {
  const core = list.filter((p) => p.core);
  if (list.length <= FOLD_ABOVE || core.length === 0) return { core: [], rest: list, fold: false };
  return { core, rest: list.filter((p) => !p.core), fold: true };
};
---
<div class="funnel" data-funnel>
  <div class="figure">
    <!-- small containers: the axis label is text that can wrap, the funnel takes the full width -->
    <p class="axis-cap"><span aria-hidden="true">↓</span> {costLabel}</p>
    <!-- One link per layer; inside it, a wide and a narrow drawing (nested SVGs with their own viewBox),
         one of them shown by the container query below. -->
    <svg class="fig" role="group" aria-label={svgLabel} style={`--ar-wide: ${W + 60} / ${wide.H}; --ar-narrow: ${W} / ${narrow.H}`}>
      <svg class="w" viewBox={`-60 0 ${W + 60} ${wide.H}`}>
        <defs>
          <marker id="arrowhead" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" fill="var(--ink-2)" /></marker>
        </defs>
        <line x1="-30" y1={TOP + 6} x2="-30" y2={wide.H - 14} stroke="var(--ink-2)" stroke-width="2" marker-end="url(#arrowhead)" />
        <text x="-40" y={wide.H / 2} transform={`rotate(-90 -40 ${wide.H / 2})`} text-anchor="middle" class="axis">{costLabel}</text>
      </svg>
      {wide.bands.map(({ layer, y0, d, count, name, size }, i) => {
        const n = narrow.bands[i]!;
        return (
          <a href={`#layer-${layer.id}`} data-band={layer.id} aria-label={`${name}: ${layer.examples[lang]} (${countLabel(count)})`} style={`--c: var(--l-${layer.id})`}>
            <svg class="w" viewBox={`-60 0 ${W + 60} ${wide.H}`}>
              <path d={d} class="band" />
              <text x={MID} y={y0 + wide.g.nameY} text-anchor="middle" class="name" font-size={size}>{name}</text>
              <text x={MID} y={y0 + wide.g.countY} text-anchor="middle" class="count" font-size={wide.g.count}>{countLabel(count)}</text>
            </svg>
            <svg class="n" viewBox={`0 0 ${W} ${narrow.H}`}>
              <path d={n.d} class="band" />
              <text x={MID} y={n.y0 + narrow.g.nameY} text-anchor="middle" class="name" font-size={n.size}>{name}</text>
              <text x={MID} y={n.y0 + narrow.g.countY} text-anchor="middle" class="count" font-size={narrow.g.count}>{countLabel(count)}</text>
            </svg>
          </a>
        );
      })}
    </svg>
    <p class="credit"><a href={href(lang, 'references/#lauren-tan-talk')}>{en ? 'After a talk by Lauren Tan (@poteto)' : 'Nach einem Vortrag von Lauren Tan (@poteto)'}</a>.</p>
  </div>

  <div class="panels">
    <div class="prompt" data-funnel-prompt hidden>
      <h3>{HOME.chooseLayer[lang]}</h3>
      <p class="hint">{HOME.chooseLayerHint[lang]}</p>
      <ol class="layers">
        {bands.map(({ layer, i, count }) => (
          <li style={`--c: var(--l-${layer.id})`}>
            <a href={`#layer-${layer.id}`} data-band-link={layer.id}>
              <span class="n" aria-hidden="true">{i + 1}</span>
              <span class="what"><strong>{layer.name[lang]}</strong><span class="ex">{layer.examples[lang]}</span></span>
              <span class="cnt">{countLabel(count)}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>

    <div class="legend" data-funnel-legend><CardKey lang={lang} /></div>

    {LAYERS.map((layer, i) => {
      const list = byLayer(layer.id);
      const { core, rest, fold } = split(list);
      return (
        <section class="panel" id={`layer-${layer.id}`} data-panel={layer.id} style={`--c: var(--l-${layer.id})`}>
          <h3 class="layer-title"><span class="n" aria-hidden="true">{i + 1}</span>{layer.name[lang]}</h3>
          <p class="examples">{layer.examples[lang]}</p>
          <p>{layer.idea[lang]}</p>
          {fold ? (
            <>
              <h3 class="sub">{t(lang, 'startWith')}</h3>
              <div class="grid cols-2 list">{core.map((p) => <PracticeCard p={p} lang={lang} compact />)}</div>
              <details class="disclose fold">
                <summary><span>{en ? `${rest.length} more practices` : `${rest.length} weitere Praktiken`} <span class="total">{en ? `(${list.length} in this layer)` : `(${list.length} in dieser Schicht)`}</span></span></summary>
                <div class="body"><div class="grid cols-2 list">{rest.map((p) => <PracticeCard p={p} lang={lang} compact />)}</div></div>
              </details>
            </>
          ) : (
            <div class="grid cols-2 list">{rest.map((p) => <PracticeCard p={p} lang={lang} compact />)}</div>
          )}
        </section>
      );
    })}

  </div>
</div>

<style>
  .funnel { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 36px; align-items: start; }
  @media (max-width: 900px) { .funnel { grid-template-columns: 1fr; } }
  .figure { position: sticky; top: 4.75rem; }
  @media (max-width: 900px) { .figure { position: static; } }
  svg { width: 100%; height: auto; display: block; overflow: visible; }
  .band { fill: color-mix(in srgb, var(--c) 14%, var(--card)); stroke: var(--ink); stroke-width: 1.5; transition: fill .2s; }
  a:hover .band, a:focus-visible .band { fill: color-mix(in srgb, var(--c) 30%, var(--card)); }
  a[aria-current='true'] .band { fill: color-mix(in srgb, var(--c) 42%, var(--card)); stroke-width: 2.5; }
  a:focus-visible { outline: none; }
  a:focus-visible .band { stroke: var(--focus); stroke-width: 3; }
  /* SVG text sizes are font-size attributes in viewBox units, fitted per band in the frontmatter */
  .name { font-family: var(--font-display); font-weight: 650; fill: var(--ink); }
  .count { font-family: var(--font-body); font-weight: 600; fill: var(--ink-2); }
  .axis { font-size: 20px; fill: var(--ink-2); letter-spacing: .04em; }
  /* one drawing at a time, chosen by the figure's own width (also narrow beside the panels at ~900px) */
  .figure { container-type: inline-size; }
  .fig { aspect-ratio: var(--ar-wide); height: auto; }
  .fig svg { width: 100%; height: 100%; overflow: visible; }
  .fig .n, .axis-cap { display: none; }
  @container (max-width: 30rem) {
    .fig { aspect-ratio: var(--ar-narrow); }
    .fig .w { display: none; }
    .fig .n { display: inline; }
    .axis-cap { display: block; margin: 0 0 6px; font-size: var(--fs-sm); color: var(--ink-2); }
  }
  .credit { font-size: var(--fs-sm); color: var(--ink-3); margin-top: 8px; }

  /* the layer number in the layer colour: one marker for the chooser rows and the panel heading */
  .n { flex: none; display: inline-grid; place-items: center; inline-size: 1.75rem; block-size: 1.75rem; border-radius: 50%; font: 700 var(--fs-sm)/1 var(--font-body); color: var(--ink); background: color-mix(in srgb, var(--c) 22%, var(--card)); border: 1.5px solid var(--c); }

  .prompt { padding-top: 4px; }
  .prompt h3 { font-size: var(--fs-lg); margin-bottom: 4px; }
  .hint { color: var(--ink-2); font-size: var(--fs-ui); margin-bottom: 0; }
  .layers { list-style: none; padding: 0; margin: 12px 0 0; border-top: 1px solid var(--rule); }
  .layers li { margin: 0; border-bottom: 1px solid var(--rule); }
  .layers a { display: grid; grid-template-columns: auto 1fr auto; gap: 14px; align-items: center; padding: 12px 8px; border-radius: var(--radius); color: var(--ink); text-decoration: none; }
  .layers a:hover { background: var(--paper-2); }
  .layers a:hover strong { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
  .layers .what { display: flex; flex-direction: column; min-width: 0; }
  .layers .ex { color: var(--ink-2); font-size: var(--fs-sm); }
  .layers .cnt { font-size: var(--fs-sm); color: var(--ink-2); white-space: nowrap; }

  .panel { padding: 22px 0 26px; border-top: 3px solid var(--c); scroll-margin-top: 4.5rem; }
  .panel + .panel { margin-top: 8px; }
  .layer-title { display: flex; align-items: center; gap: 12px; font-size: var(--fs-h2); margin-bottom: 4px; }
  .examples { color: var(--ink-3); font-size: var(--fs-sm); margin-bottom: 0.75rem; }
  .list { margin-top: 10px; }
  .sub { font: 700 var(--fs-xs)/1.2 var(--font-body); letter-spacing: .12em; text-transform: uppercase; color: var(--ink-2); margin: 18px 0 0; }
  .fold { margin-top: 14px; }
  .fold .total { font-weight: 400; color: var(--ink-3); }
  .fold .body .list { margin-top: 0; }

  .legend { padding: 0; }
  /* with JS: one panel at a time; the legend only matters once cards are shown */
  :global(.js) .panel[hidden] { display: none; }
  .panels:has([data-funnel-prompt]:not([hidden])) .legend { display: none; }
</style>

<script>
  document.documentElement.classList.add('js');
  for (const root of document.querySelectorAll<HTMLElement>('[data-funnel]')) {
    const bands = [...root.querySelectorAll<SVGAElement>('[data-band]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const prompt = root.querySelector<HTMLElement>('[data-funnel-prompt]')!;
    const known = (id: string | undefined) => (id && panels.some((p) => p.dataset.panel === id) ? id : null);
    const fromHash = () => known(location.hash.match(/^#layer-(\w+)/)?.[1]);
    const panelOf = (id: string) => root.querySelector<HTMLElement>(`[data-panel="${id}"]`);
    /** null = nothing chosen yet: show the prompt instead of a panel */
    const select = (id: string | null) => {
      bands.forEach((b) => b.setAttribute('aria-current', String(b.dataset.band === id)));
      panels.forEach((p) => (p.hidden = p.dataset.panel !== id));
      prompt.hidden = id !== null;
    };
    const choose = (id: string) => {
      select(id);
      history.replaceState(null, '', `#layer-${id}`);
      if (matchMedia('(max-width: 900px)').matches) panelOf(id)?.scrollIntoView({ block: 'start', behavior: 'smooth' });
    };
    bands.forEach((b) => b.addEventListener('click', (e) => { e.preventDefault(); choose(b.dataset.band!); }));
    for (const a of root.querySelectorAll<HTMLAnchorElement>('[data-band-link]')) {
      a.addEventListener('click', (e) => { e.preventDefault(); choose(a.dataset.bandLink!); });
    }
    addEventListener('hashchange', () => { const id = fromHash(); if (id) select(id); });
    const initial = fromHash();
    select(initial);
    if (initial) panelOf(initial)?.scrollIntoView({ block: 'start' });
  }
</script>
