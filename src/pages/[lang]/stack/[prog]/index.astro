---
import Base from '../../../../layouts/Base.astro';
import { STACK_COPY } from '../../../../data/page-copy';
import type { LangId, Locale } from '../../../../data/types';
import { LANGS, LAYERS } from '../../../../data/taxonomy';
import { PRACTICES } from '../../../../data/practices';
import { href, t } from '../../../../i18n/ui';
import { toolsFor } from '../../../../lib/prompts';
export function getStaticPaths() {
  return (['en', 'de'] as Locale[]).flatMap((lang) => LANGS.map((lg) => ({ params: { lang, prog: lg.id }, props: { lang, prog: lg.id } })));
}
const { lang, prog } = Astro.props as { lang: Locale; prog: LangId };
const en = lang === 'en';
const lg = LANGS.find((x) => x.id === prog)!;
const core = PRACTICES.filter((p) => p.core);
const groups = [
  { id: 'core', title: t(lang, 'startWith'), c: 'var(--ink)', list: core, core: true },
  ...LAYERS.map((layer) => ({ id: layer.id, title: layer.name[lang], c: `var(--l-${layer.id})`, list: PRACTICES.filter((p) => p.layer === layer.id), core: false })),
];
---
<Base lang={lang} path={`stack/${prog}/`} md={`/${lang}/stack/${prog}/index.md`} nav="stack" title={lg.name} description={en ? `Verification practices and open-source tools for ${lg.name}.` : `Verifikationspraktiken und Open-Source-Werkzeuge für ${lg.name}.`}>
  <div class="wrap">
    <nav class="breadcrumb small" aria-label={en ? 'Breadcrumbs' : 'Brotkrumen'}><ol><li><a href={href(lang, 'stack/')}>{t(lang, 'navStack')}</a></li><li><a href={href(lang, `stack/${prog}/`)} aria-current="page">{lg.name}</a></li></ol></nav>
    <header>
      <h1>{lg.name}</h1>
      <p class="lede">{STACK_COPY.languageIntro[lang]}</p>
    </header>
    {groups.map((g, gi) => (
      <>
        {gi === 1 && <h2 class="all">{en ? `All ${PRACTICES.length} practices by layer` : `Alle ${PRACTICES.length} Praktiken nach Schicht`}</h2>}
        <section class:list={['layer', { core: g.core }]} style={`--c: ${g.c}`}>
          {g.core ? <h2>{g.title}</h2> : <h3>{g.title}</h3>}
          <table>
            <tbody>
              {g.list.map((p) => {
                const { own, any } = toolsFor(p, prog);
                return (
                  <tr>
                    <th scope="row"><a href={`${href(lang, `practices/${p.id}/`)}?lang=${prog}`}>{p.name[lang]}</a></th>
                    <td>
                      {own.map((x, i) => <><a href={x.url} rel="noopener"><strong>{x.name}</strong></a>{i < own.length - 1 || any.length ? ', ' : ''}</>)}
                      {any.map((x, i) => <><a href={x.url} rel="noopener">{x.name}</a>{i < any.length - 1 ? ', ' : ''}</>)}
                      {own.length + any.length === 0 && <span class="muted">{en ? 'method, no tool needed' : 'Methode, kein Werkzeug nötig'}</span>}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </section>
      </>
    ))}
  </div>
</Base>
<style>
  .layer:nth-of-type(n + 4) { content-visibility: auto; contain-intrinsic-size: auto none auto 18rem; }
  .layer { margin-top: 28px; border-top: 3px solid var(--c); padding-top: 12px; }
  .layer.core { background: var(--card); border: 1px solid var(--rule); border-top: 3px solid var(--ink); border-radius: var(--radius); padding: 16px 18px 6px; }
  .layer.core p { margin: 0 0 6px; }
  .layer h3 { font-size: var(--fs-lg); }
  .all { margin-top: 48px; margin-bottom: 0; }
  tr:last-child th, tr:last-child td { border-bottom: 0; }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 8px 10px 8px 0; border-bottom: 1px solid var(--rule); vertical-align: top; font-weight: 400; }
  th { width: 34%; }
  th a { font-weight: 700; color: var(--ink); }
  @media (max-width: 600px) { tr { display: block; padding: 8px 0; border-bottom: 1px solid var(--rule); } th, td { display: block; width: auto; border: 0; padding: 2px 0; } }
</style>
