---
import Base from '../../layouts/Base.astro';
import { GLOSSARY_COPY } from '../../data/page-copy';
import type { Locale } from '../../data/types';
import { GLOSSARY } from '../../data/glossary';
import { PRACTICE_BY_ID } from '../../data/practices';
import { href } from '../../i18n/ui';
import { langPaths } from '../../lib/paths';
import { devMark } from '../../lib/dev-mark';
export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Locale };
const en = lang === 'en';
const terms = [...GLOSSARY].sort((a, b) => a.term[lang].localeCompare(b.term[lang], lang));
---
<Base lang={lang} path="glossary/" md={`/${lang}/glossary/index.md`} nav="glossary" title={en ? 'Glossary' : 'Glossar'} description={GLOSSARY_COPY.description[lang]}>
  <div class="wrap narrow">
    <header {...devMark('tighter lede')}>
      <h1>{en ? 'Glossary' : 'Glossar'}</h1>
      <p class="lede">{GLOSSARY_COPY.intro[lang]}</p>
    </header>
    <dl>
      {terms.map((x) => (
        <div id={x.id} class="term">
          <dt>{x.term[lang]}</dt>
          <dd>{x.def[lang]} {x.see && <a href={href(lang, `practices/${x.see}/`)}>→ {PRACTICE_BY_ID.get(x.see)!.name[lang]}</a>}</dd>
        </div>
      ))}
    </dl>
  </div>
</Base>
<style>
  .term { padding: 12px 0; border-bottom: 1px solid var(--rule); scroll-margin-top: 80px; }
  .term:target { background: color-mix(in srgb, var(--warn) 10%, transparent); }
  dt { font-weight: 700; font-family: var(--font-display); font-size: var(--fs-lg); }
  dd { margin: 4px 0 0; color: var(--ink-2); }
</style>
