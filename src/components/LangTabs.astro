---
import type { Locale, Practice } from '../data/types';
import { LANGS } from '../data/taxonomy';
import { t } from '../i18n/ui';
import { agentPrompt, toolsFor, langName } from '../lib/prompts';
import CodeBlock from './CodeBlock.astro';
import { devMark } from '../lib/dev-mark';
interface Props { p: Practice; lang: Locale; socratic: string }
const { p, lang, socratic } = Astro.props;
const hasAnyTools = Object.values(p.tools).some((x) => x?.length);
const firstSnippet = p.snippets?.[0];
// every tool and example is language-independent: one panel, no tab bar, no per-language notice
const single = LANGS.every((lg) => !p.tools[lg.id]?.length) && (p.snippets ?? []).every((x) => x.lang === 'any');
const shown = single ? LANGS.slice(0, 1) : LANGS;
---
<div class="langtabs" data-langtabs data-single={single ? '' : undefined}>
  {!single && <div class="tabs" role="tablist" aria-label={t(lang, 'yourLanguage')}>
    {LANGS.map((lg, i) => (
      <button role="tab" type="button" id={`tab-${lg.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-lang={lg.id}>{lg.short}</button>
    ))}
  </div>}
  {shown.map((lg, li) => {
    const { own, any } = toolsFor(p, lg.id);
    const snippets = (p.snippets ?? []).filter((s) => s.lang === lg.id || s.lang === 'any');
    const fallback = snippets.length === 0 && firstSnippet ? (p.snippets ?? []).filter((s) => s.lang === firstSnippet.lang) : [];
    const promptId = `prompt-${p.id}-${lg.id}`;
    return (
      <section role="tabpanel" id={`panel-${lg.id}`} aria-labelledby={`tab-${lg.id}`} data-panel={lg.id} class="panel" hidden={li === 0 ? undefined : 'until-found'}>
        {!single && <h3 class="visually-hidden">{lg.name}</h3>}
        {!hasAnyTools && <p class="muted">{t(lang, 'noTools')}</p>}
        {!single && hasAnyTools && own.length === 0 && any.length > 0 && <p class="muted small">{t(lang, 'noToolsForLang')}</p>}
        {(own.length > 0 || any.length > 0) && (
          <div class="table-wrap" role="region" aria-label={`${t(lang, 'tools')}: ${lg.name}`} tabindex="0">
            <table class="tools">
              <thead><tr><th scope="col">{t(lang, 'tools')}</th><th scope="col">{t(lang, 'license')}</th><th scope="col">{t(lang, 'repo')}</th></tr></thead>
              <tbody>
                {own.map((x) => <tr><th scope="row"><a href={x.url} rel="noopener">{x.name}</a></th><td data-label={t(lang, 'license')}><code>{x.license}</code></td><td data-label={t(lang, 'repo')}><a href={x.repo} rel="noopener" class="muted small">{t(lang, 'source')}</a></td></tr>)}
                {any.map((x) => <tr class="anyrow"><th scope="row"><a href={x.url} rel="noopener">{x.name}</a> {!single && <span class="muted small">({t(lang, 'anyLanguage').toLowerCase()})</span>}</th><td data-label={t(lang, 'license')}><code>{x.license}</code></td><td data-label={t(lang, 'repo')}><a href={x.repo} rel="noopener" class="muted small">{t(lang, 'source')}</a></td></tr>)}
              </tbody>
            </table>
          </div>
        )}
        {snippets.map((snip, i) => <>
          {snip.description && <p class="small">{snip.description[lang]}</p>}
          <CodeBlock code={snip.code} file={snip.file} lang={lang} focus={snip.focus} id={`snip-${p.id}-${lg.id}${i ? `-${i}` : ''}`} />
        </>)}
        {fallback.length > 0 && (
          <>
            <p class="muted small">{t(lang, 'exampleOtherLang')} {langName(fallback[0].lang)}:</p>
            {fallback.map((snip, i) => <>
              {snip.description && <p class="small">{snip.description[lang]}</p>}
              <CodeBlock code={snip.code} file={snip.file} lang={lang} focus={snip.focus} id={`snipfb-${p.id}-${lg.id}${i ? `-${i}` : ''}`} />
            </>)}
          </>
        )}
        <div class="agent card" role="group" aria-labelledby={`agent-h-${lg.id}`} {...devMark('tighter agent box')}>
          <h4 class="agent-h" id={`agent-h-${lg.id}`}>{t(lang, 'useWithAgent')}</h4>
          <div class="agent-actions">
            <button type="button" class="btn" data-copy={promptId} command="--copy" commandfor={promptId}>{t(lang, 'copyTask')}</button>
          </div>
          <details class="more preview"><summary>{t(lang, 'previewTask')}</summary><pre id={promptId} tabindex="0">{agentPrompt(p, lang, lg.id, single)}</pre>
            <div class="act tutor"><button type="button" class="btn ghost" data-copy="socratic" command="--copy" commandfor="socratic" data-proglang>{t(lang, 'copyTutor')}</button></div>
          </details>
        </div>
      </section>
    );
  })}
  <pre id="socratic" hidden>{socratic}</pre>
</div>
<style>
  /* eight short labels: all visible, none cut off at the scroll edge; on phones two rows of four */
  .tabs { flex-wrap: wrap; overflow: visible; }
  @media (max-width: 560px) {
    .tabs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; border-bottom: 0; }
    .tabs [role='tab'] { border-bottom: 1px solid var(--rule); padding-inline: 4px; }
  }
  .table-wrap { overflow-x: auto; container-type: inline-size; max-inline-size: 100%; margin-bottom: 8px; }
  .tools { width: 100%; border-collapse: collapse; font-size: var(--fs-ui); }
  .tools th { text-align: left; font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: .08em; color: var(--ink-3); font-weight: 600; padding: 6px 8px; border-bottom: 1px solid var(--rule); }
  .tools tbody th { font-size: inherit; text-transform: none; letter-spacing: 0; color: inherit; font-weight: 400; padding-left: 0; background: transparent; vertical-align: top; padding-block: 7px; }
  .tools td code { font-size: var(--fs-code); }
  .tools td { padding: 7px 8px; border-bottom: 1px solid var(--rule); vertical-align: top; }
  /* narrow container: one line per tool (name, license, source link), wrapping only when the name is long */
  @container (width < 26rem) {
    .tools, .tools tbody { display: block; }
    .tools thead { display: none; }
    .tools tr { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 12px; padding: 7px 0; border-bottom: 1px solid var(--rule); }
    .tools tbody th { flex: 1 1 auto; padding: 0; border: 0; }
    .tools td { padding: 0; border: 0; }
  }
  .agent { margin-top: 18px; }
  .agent-h { font-size: var(--fs-body); margin: 0 0 10px; }
  .agent-actions { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 12px 20px; }
  .act { display: grid; gap: 4px; align-content: start; justify-items: start; }
  .act p { margin: 0; max-width: 30rem; }
  .preview { margin-top: 10px; }
  .tutor { margin-top: 12px; }
  .preview pre { margin-top: 8px; white-space: pre-wrap; font-size: var(--fs-code); }
</style>
<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-langtabs]:not([data-single])')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const select = (id: string, save = true, reveal = true) => {
      tabs.forEach((b) => { const on = b.dataset.lang === id; b.setAttribute('aria-selected', String(on)); b.tabIndex = on ? 0 : -1; });
      // Inactive panels stay findable with Ctrl+F (until-found); browsers without it simply hide them.
      panels.forEach((p) => { if (p.dataset.panel === id) p.removeAttribute('hidden'); else p.setAttribute('hidden', 'until-found'); });
      if (reveal) tabs.find((b) => b.dataset.lang === id)?.scrollIntoView({ block: 'nearest', inline: 'nearest', container: 'nearest' } as ScrollIntoViewOptions);
      if (save) try { localStorage.setItem('progLang', id); } catch {}
    };
    // find-in-page revealed a hidden panel: make its tab the selected one (beforematch bubbles)
    root.addEventListener('beforematch', (e) => { const p = (e.target as HTMLElement).closest<HTMLElement>('[role="tabpanel"]'); if (p?.dataset.panel) select(p.dataset.panel); });
    tabs.forEach((b, i) => {
      b.addEventListener('click', () => select(b.dataset.lang!));
      b.addEventListener('keydown', (e) => {
        const to = e.key === 'ArrowRight' ? (i + 1) % tabs.length : e.key === 'ArrowLeft' ? (i + tabs.length - 1) % tabs.length : e.key === 'Home' ? 0 : e.key === 'End' ? tabs.length - 1 : -1;
        if (to < 0) return;
        e.preventDefault();
        const n = tabs[to]; n.focus(); select(n.dataset.lang!);
      });
    });
    const fromUrl = new URLSearchParams(location.search).get('lang');
    let initial = fromUrl ?? 'js';
    if (!fromUrl) try { initial = localStorage.getItem('progLang') ?? 'js'; } catch {}
    select(tabs.some((b) => b.dataset.lang === initial) ? initial : 'js', Boolean(fromUrl), false);
  }
</script>
