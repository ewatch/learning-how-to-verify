---
import Base from '../../layouts/Base.astro';
import type { Locale } from '../../data/types';
import { PRACTICE_BY_ID } from '../../data/practices';
import { DIAGNOSE_COPY as C, START_ROUTES, START_LOOP, startAgentPrompt } from '../../data/start';
import { href } from '../../i18n/ui';
import { langPaths } from '../../lib/paths';
export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Locale };
const practiceUrl = (id: string) => href(lang, `practices/${id}/`);
const practiceName = (id: string) => PRACTICE_BY_ID.get(id)!.name[lang];
---
<Base lang={lang} path="diagnose/" title={C.title[lang]} description={C.description[lang]} md={`/${lang}/diagnose/index.md`}>
  <article class="wrap diagnose">
    <header class="narrow">
      <h1>{C.title[lang]}</h1>
      <p class="lede">{C.intro[lang]}</p>
      <p class="small muted">{C.tour[lang]} <a href={href(lang, 'start/')}>{C.tourLink[lang]} →</a></p>
    </header>

    <section class="layer-section" aria-labelledby="where-start" data-start-picker>
      <h2 id="where-start">{C.chooser[lang]}</h2>
      <div class="starting-points" role="group" aria-labelledby="where-start">
        {START_ROUTES.map((route, i) => <button type="button" class="starting-point" data-start-choice={route.id} aria-pressed={i === 0 ? 'true' : 'false'} aria-controls={`start-${route.id}`}>
          <span class="small muted">{String(i + 1).padStart(2, '0')}</span><span>{route.label[lang]}</span>
        </button>)}
      </div>
      <div aria-live="polite" aria-atomic="false">
        {START_ROUTES.map((route) => <section id={`start-${route.id}`} class="recommendation card" data-start-result={route.id} aria-labelledby={`heading-${route.id}`}>
          <p class="eyebrow">{C.first[lang]}</p>
          <h3 id={`heading-${route.id}`}><a href={practiceUrl(route.practice)}>{practiceName(route.practice)}</a></h3>
          <p class="narrow">{route.why[lang]}</p>
          <dl class="exercise">
            <div><dt>{C.exercise[lang]}</dt><dd>{route.exercise[lang]}</dd></div>
            <div><dt>{C.feedback[lang]}</dt><dd>{route.feedback[lang]}</dd></div>
            <div><dt>{C.done[lang]}</dt><dd>{route.done[lang]}</dd></div>
          </dl>
          <div class="actions">
            <a class="btn" href={practiceUrl(route.practice) + (route.practice === 'type-systems' ? '#try' : '')}>{C.open[lang]} →</a>
            <button class="btn ghost" type="button" data-copy={`start-prompt-${route.id}`} command="--copy" commandfor={`start-prompt-${route.id}`}>{C.copy[lang]}</button>
          </div>
          <details class="more task"><summary>{C.preview[lang]}</summary><pre id={`start-prompt-${route.id}`} tabindex="0">{startAgentPrompt(route, lang)}</pre></details>
          <p class="next"><strong>{C.next[lang]}:</strong> <a href={practiceUrl(route.next)}>{practiceName(route.next)} →</a></p>
        </section>)}
      </div>
    </section>

    <section class="layer-section" aria-labelledby="feedback-loop">
      <h2 id="feedback-loop">{C.loop[lang]}</h2>
      <p class="muted narrow">{C.loopHint[lang]}</p>
      <ol class="loop">
        {START_LOOP.map((step) => <li><h3>{step.title[lang]}</h3><p>{step.text[lang]}</p></li>)}
      </ol>
    </section>

  </article>
</Base>
<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-start-picker]')) {
    const choices = [...root.querySelectorAll<HTMLButtonElement>('[data-start-choice]')];
    const results = [...root.querySelectorAll<HTMLElement>('[data-start-result]')];
    function select(id: string) {
      choices.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.startChoice === id)));
      results.forEach((panel) => { panel.hidden = panel.dataset.startResult !== id; });
    }
    choices.forEach((button) => button.addEventListener('click', () => select(button.dataset.startChoice!)));
    select(choices[0].dataset.startChoice!);
  }
</script>
<style>
  .diagnose { max-width: 65rem; }
  header { margin-bottom: 32px; }
  .starting-points { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin: 24px 0 14px; }
  .starting-point { display: flex; align-items: baseline; gap: 12px; text-align: left; cursor: pointer; padding: 14px 16px; border: 1px solid var(--rule-strong); border-radius: var(--radius); background: var(--card); line-height: 1.4; }
  .starting-point:hover { border-color: var(--l-static); }
  .starting-point[aria-pressed='true'] { border-color: var(--l-static); box-shadow: inset 4px 0 var(--l-static); background: color-mix(in srgb, var(--l-static) 8%, var(--card)); }
  .recommendation { border-top: 3px solid var(--l-static); padding: clamp(16px, 3vw, 28px); margin-bottom: 14px; }
  .recommendation h3 { font-size: var(--fs-h2); }
  .exercise { margin: 24px 0; display: grid; gap: 16px; }
  .exercise > div { display: grid; grid-template-columns: 10rem minmax(0, 1fr); gap: 16px; }
  .exercise dt { font-weight: 700; line-height: 1.4; }
  .exercise dd { margin: 0; color: var(--ink-2); }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .task { margin: 14px 0; }
  .task pre { white-space: pre-wrap; overflow-wrap: anywhere; font-size: var(--fs-code); margin-top: 8px; }
  .next { margin: 18px 0 0; font-size: var(--fs-ui); }
  .loop { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin: 24px 0 0; }
  .loop li { border-left: 2px solid var(--rule-strong); padding-left: 16px; margin: 0; }
  .loop p { margin: 0; color: var(--ink-2); }
  @media (max-width: 650px) {
    .starting-points, .loop { grid-template-columns: 1fr; }
    .exercise > div { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
