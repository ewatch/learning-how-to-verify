---
import Base from '../../../layouts/Base.astro';
import { STACK_COPY } from '../../../data/page-copy';
import type { Locale } from '../../../data/types';
import { LANGS } from '../../../data/taxonomy';
import { PRACTICES } from '../../../data/practices';
import { href, t } from '../../../i18n/ui';
import { langPaths } from '../../../lib/paths';
export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Locale };
const en = lang === 'en';
---
<Base lang={lang} path="stack/" md={`/${lang}/stack/index.md`} nav="stack" title={t(lang, 'navStack')} description={STACK_COPY.intro[lang]}>
  <div class="wrap">
    <header class="narrow">
      <h1>{STACK_COPY.heading[lang]}</h1>
      <p class="lede">{STACK_COPY.intro[lang]}</p>
    </header>
    <div class="grid cols-3 langs">
      {LANGS.map((lg) => {
        const n = PRACTICES.filter((p) => (p.tools[lg.id]?.length ?? 0) > 0).length;
        return <a class="card lg" href={href(lang, `stack/${lg.id}/`)}><strong>{lg.name}</strong><span class="muted small">{en ? `${n} practices with dedicated tools` : `${n} Praktiken mit eigenen Werkzeugen`}</span></a>;
      })}
    </div>
  </div>
</Base>
<style>
  .langs { margin-top: 24px; }
  .lg { display: flex; flex-direction: column; gap: 4px; text-decoration: none; color: var(--ink); font-size: var(--fs-lg); }
  .lg:hover { border-color: var(--rule-strong); }
</style>
