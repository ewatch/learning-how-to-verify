---
import type { Evidence, Locale } from '../data/types';
import { RATING_LABEL } from '../data/taxonomy';
import { SOURCE_BY_ID } from '../data/sources';
import { t } from '../i18n/ui';
interface Props { general: Evidence; ai: Evidence; lang: Locale }
const { general, ai, lang } = Astro.props;
const n = { strong: 3, moderate: 2, weak: 1, none: 0 } as const;
const rows = [['evidenceGeneral', general], ['evidenceAi', ai]] as const;
---
<div class="evidence grid cols-2">
  {rows.map(([k, e]) => (
    <div class="ev card">
      <p class="eyebrow">{t(lang, k)}</p>
      <p class="rating"><span class="meter" data-n={n[e.rating]}><i /><i /><i /></span>{RATING_LABEL[e.rating][lang]}</p>
      {e.findings.length === 0 ? <p class="muted small">{t(lang, 'evidenceNone')}</p> : (
        <ul>
          {e.findings.map((fi) => {
            const s = SOURCE_BY_ID.get(fi.src)!;
            return (
              <li>
                {fi.text[lang]}{' '}
                <a class="src" href={s.url} rel="noopener">{s.authors.split(',')[0]}{s.authors.includes(',') ? ' et al.' : ''}, {s.venue} {s.year}</a>
                {s.preprint && <span class="badge">{t(lang, 'preprint')}</span>}
              </li>
            );
          })}
        </ul>
      )}
    </div>
  ))}
</div>
<style>
  .ev ul { padding-left: 1.1em; margin: 0; font-size: .95rem; }
  .ev li { margin-bottom: .6em; }
  .src { font-size: .85rem; color: var(--ink-3); }
  .badge { margin-left: 4px; vertical-align: 1px; }
  .rating { margin-bottom: 10px; }
</style>
