---
import type { Locale, Practice } from '../data/types';
import { LAYERS, PHASES, COST_LABEL, FEEDBACK_LABEL } from '../data/taxonomy';
import { t, href } from '../i18n/ui';
import FunnelMark from './FunnelMark.astro';
interface Props { p: Practice; lang: Locale }
const { p, lang } = Astro.props;
const layer = LAYERS.find((l) => l.id === p.layer)!;
const phases = PHASES.filter((ph) => p.phases.includes(ph.id));
---
<!-- one-line "where it sits": layer, lifecycle phases, cost, feedback time -->
<dl class="strip">
  <div><dt class="visually-hidden">{t(lang, 'layer')}</dt><dd><a class="chip layer" href={href(lang, `#layer-${p.layer}`)} style={`--c: var(--l-${p.layer})`}><FunnelMark size={16} on={p.layer} />{layer.name[lang]}</a></dd></div>
  <div><dt>{t(lang, 'phase')}</dt><dd class="phases">
    {phases.map((ph) => <a href={href(lang, `lifecycle/#phase-${ph.id}`)} class="ph" style={`--pc: var(--p-${ph.id})`}>{ph.name[lang]}</a>)}
  </dd></div>
  <div><dt>{t(lang, 'cost')}</dt><dd><span class="meter" data-n={p.cost} aria-hidden="true"><i /><i /><i /></span> {COST_LABEL[p.cost][lang]}</dd></div>
  <div><dt>{t(lang, 'feedback')}</dt><dd>{FEEDBACK_LABEL[p.feedback][lang]}</dd></div>
</dl>
<style>
  .strip { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 22px; margin: 0; font-size: var(--fs-sm); }
  .strip > div { display: flex; align-items: center; gap: 6px; }
  dt { color: var(--ink-3); }
  dd { margin: 0; display: inline-flex; align-items: center; gap: 6px; }
  .layer { gap: 6px; padding-block: 3px; border-color: var(--c); }
  .layer :global(svg) { flex: none; }
  .phases { display: flex; flex-wrap: wrap; gap: 4px; }
  .ph { font-size: var(--fs-sm); padding: 1px 8px; border-radius: 4px; border: 1px solid var(--pc); background: color-mix(in srgb, var(--pc) 16%, var(--card)); color: var(--ink); text-decoration: none; }
  .ph:hover { text-decoration: underline; }
</style>
