---
import '../styles/global.css';
import type { Locale } from '../data/types';
import { t, other, href } from '../i18n/ui';
import FunnelMark from '../components/FunnelMark.astro';
import SearchDialog from '../components/SearchDialog.astro';
import TourBar from '../components/TourBar.astro';
import { BASE } from '../lib/site';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  /** path after /{lang}/, e.g. "practices/unit-tests/" */
  path: string;
  /** optional Markdown twin for LLMs */
  md?: string;
  nav?: 'funnel' | 'lifecycle' | 'stack' | 'start' | 'guides' | 'glossary' | 'about';
}
const { lang, title, description, path, nav } = Astro.props;
const md = Astro.props.md && BASE + Astro.props.md;
const alt = other(lang);
const site = Astro.site!;
const canonical = new URL(href(lang, path), site).href;
const items = [
  ['funnel', '', t(lang, 'navFunnel')],
  ['lifecycle', 'lifecycle/', t(lang, 'navLifecycle')],
  ['stack', 'stack/', t(lang, 'navStack')],
  ['start', 'start/', t(lang, 'navStart')],
  ['guides', 'guides/', t(lang, 'navGuides')],
  ['glossary', 'glossary/', t(lang, 'navGlossary')],
] as const;
const fullTitle = path === '' ? `${t(lang, 'siteName')}: ${t(lang, 'tagline')}` : `${title} · ${t(lang, 'siteName')}`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="text-scale" content="scale" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={alt} href={new URL(href(alt, path), site).href} />
    {md && <link rel="alternate" type="text/markdown" href={md} title="Markdown" />}
    <link rel="alternate" type="text/plain" href={`${BASE}/llms.txt`} title="llms.txt" />
    <link rel="icon" href={`${BASE}/favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      // Pinned scheme ("light" | "dark"); no stored value = follow the system. Must run before first paint.
      try { const v = localStorage.getItem('color-scheme'); if (v === 'light' || v === 'dark') document.querySelector('meta[name="color-scheme"]').content = v; } catch {}
    </script>
    <script is:inline>
      // Direction of a page change for the view transition: pager links (data-nav) set it, back/forward derive it from history.
      addEventListener('pagereveal', (e) => {
        if (!e.viewTransition || !window.navigation?.activation) return;
        const act = navigation.activation;
        let type = null;
        try { type = sessionStorage.getItem('nav-dir'); sessionStorage.removeItem('nav-dir'); } catch {}
        if (act.navigationType === 'traverse' && act.from) type = act.entry.index < act.from.index ? 'backward' : 'forward';
        if (type === 'forward' || type === 'backward') e.viewTransition.types.add(type);
      });
      addEventListener('click', (e) => {
        const a = e.target instanceof Element && e.target.closest('a[data-nav]');
        if (a) try { sessionStorage.setItem('nav-dir', a.dataset.nav); } catch {}
      });
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t(lang, 'skip')}</a>
    <header class="site-header" data-site-header>
      <div class="wrap header-inner">
        <a class="brand" href={href(lang)}><FunnelMark size={26} /><span class="brand-text">{t(lang, 'siteName')}</span></a>
        <nav class="site-nav" aria-label="Main">
          <button class="menu-button" type="button" popovertarget="site-menu" popovertargetaction="toggle" aria-controls="site-menu"><span aria-hidden="true">☰</span> {t(lang, 'menu')}</button>
          <ul id="site-menu" class="site-menu" popover="auto">
            {items.map(([id, p, label]) => <li><a href={href(lang, p)} aria-current={nav === id ? 'page' : undefined}>{label}</a></li>)}
          </ul>
        </nav>
        <div class="header-actions">
          <button type="button" id="search-open" class="search-toggle" aria-label={t(lang, 'search')} aria-keyshortcuts="/ Control+K Meta+K" aria-haspopup="dialog" aria-controls="site-search">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
            <span class="search-label">{t(lang, 'search')}</span>
            <kbd class="search-kbd" aria-hidden="true">/</kbd>
          </button>
          <a class="lang" href={href(alt, path)} hreflang={alt} lang={alt} data-lang-switch><span class="lang-long">{t(lang, 'switchLang')}</span><span class="lang-short" aria-hidden="true">{t(lang, 'switchLangShort')}</span></a>
          <button type="button" id="theme-toggle" class="theme-toggle">
            <span aria-hidden="true">◐</span>
            <span class="to-dark visually-hidden">{t(lang, 'toDark')}</span>
            <span class="to-light visually-hidden">{t(lang, 'toLight')}</span>
          </button>
        </div>
      </div>
    </header>
    <script is:inline>
      // Navbar: inline when every link fits, otherwise the menu popover. Without script the collapsed layout stays.
      (() => {
        const header = document.querySelector('[data-site-header]');
        const inner = header.querySelector('.header-inner');
        const menu = document.getElementById('site-menu');
        if (!('popover' in HTMLElement.prototype)) { header.classList.add('is-wide', 'no-popover'); menu.removeAttribute('popover'); return; }
        const sync = () => {
          header.classList.add('is-measuring', 'is-wide');
          const wide = inner.scrollWidth <= inner.clientWidth + 1;
          header.classList.toggle('is-wide', wide);
          if (wide) menu.removeAttribute('popover'); else menu.setAttribute('popover', 'auto');
          requestAnimationFrame(() => header.classList.remove('is-measuring'));
        };
        sync();
        new ResizeObserver(sync).observe(document.documentElement);
        document.fonts?.ready.then(sync);
      })();
    </script>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>{t(lang, 'footerNote')}</p>
        <p>
          <a href={href(lang, 'about/')}>{t(lang, 'navAbout')}</a>{' · '}
          <a href={href(lang, 'references/')}>{t(lang, 'navReferences')}</a>{' · '}
          <a href={`${BASE}/llms.txt`}>llms.txt</a>{' · '}
          {md && <><a href={md}>{t(lang, 'markdown')}</a>{' · '}</>}
          <a href={href(lang, 'about/#self-verification')}>{lang === 'en' ? 'How this site verifies itself' : 'Wie diese Seite sich selbst prüft'}</a>
        </p>
      </div>
    </footer>
    <SearchDialog lang={lang} />
    <TourBar lang={lang} path={path} />
    <p id="copy-status" class="visually-hidden" role="status" data-ok={t(lang, 'copied')} data-fail={t(lang, 'copyFailed')}></p>
    <script>
      // ---- color scheme toggle: pins light/dark through <meta name="color-scheme">; works without localStorage ----
      const meta = document.querySelector<HTMLMetaElement>('meta[name="color-scheme"]')!;
      const sys = matchMedia('(prefers-color-scheme: dark)');
      const applyStored = (v: string | null) => { meta.content = v === 'light' || v === 'dark' ? v : 'light dark'; };
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const rendered = meta.content === 'light' || meta.content === 'dark' ? meta.content : sys.matches ? 'dark' : 'light';
        const target = rendered === 'dark' ? 'light' : 'dark';
        // Pin only when it differs from the system; going back to the system value clears the pin.
        const pin = target !== (sys.matches ? 'dark' : 'light');
        meta.content = pin ? target : 'light dark';
        try { if (pin) localStorage.setItem('color-scheme', target); else localStorage.removeItem('color-scheme'); } catch {}
      });
      addEventListener('storage', (e) => { if (e.key === 'color-scheme' || e.key === null) applyStored(e.newValue); });

      // ---- copy buttons: <button command="--copy" commandfor="id" data-copy="id"> copies the text of #id ----
      const LANG_NAMES: Record<string, string> = { js: 'JavaScript / TypeScript', python: 'Python', php: 'PHP', java: 'Java / Kotlin', dotnet: 'C# / .NET', go: 'Go', rust: 'Rust', cpp: 'C / C++' };
      const labels = new WeakMap<HTMLButtonElement, string>();
      const timers = new WeakMap<HTMLButtonElement, number>();
      const status = document.getElementById('copy-status')!;
      let lastMessage = '';
      function report(btn: HTMLButtonElement, ok: boolean) {
        if (!labels.has(btn)) labels.set(btn, btn.textContent ?? '');
        clearTimeout(timers.get(btn));
        let message = (ok ? status.dataset.ok : status.dataset.fail) ?? '';
        btn.textContent = ok ? `${message} ✓` : message;
        if (message === lastMessage) message += '\u00A0'; // VoiceOver skips an identical repeat
        lastMessage = message;
        status.textContent = '';
        requestAnimationFrame(() => (status.textContent = message));
        timers.set(btn, window.setTimeout(() => { btn.textContent = labels.get(btn) ?? ''; status.textContent = ''; }, 2000));
      }
      async function copy(btn: HTMLButtonElement, src: HTMLElement) {
        let text = src.textContent ?? ''; // not innerText: collapsed <details> content is not "rendered" and would read as empty
        if (btn.hasAttribute('data-proglang')) {
          let id = 'js';
          try { id = localStorage.getItem('progLang') ?? 'js'; } catch {}
          text = text.replaceAll('__PROGLANG__', LANG_NAMES[id] ?? LANG_NAMES.js);
        }
        try { await navigator.clipboard.writeText(text); report(btn, true); } catch { report(btn, false); }
      }
      if ('CommandEvent' in window) {
        // command events do not bubble: capture on document. event.source = the button, event.target = the commandfor element.
        document.addEventListener('command', (e) => {
          const ev = e as Event & { command: string; source: HTMLButtonElement | null };
          if (ev.command === '--copy' && ev.source && e.target instanceof HTMLElement) copy(ev.source, e.target);
        }, true);
      } else {
        // No Invoker Commands: same markup, same copy(), one registered path only.
        document.addEventListener('click', (e) => {
          const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[command="--copy"]');
          const src = btn && document.getElementById(btn.getAttribute('commandfor') ?? '');
          if (btn && src) copy(btn, src);
        });
      }
      // keep the hash (e.g. selected section) when switching language
      document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((a) =>
        a.addEventListener('click', () => { if (location.hash) a.href += location.hash; }),
      );
    </script>
    {import.meta.env.DEV && (
      <>
        <style is:global>
          html:not(.dev-borders-off) [data-dev-changed] {
            outline: 2px dashed light-dark(#c026d3, #e879f9);
            outline-offset: 4px;
            border-radius: 4px;
            position: relative;
          }
          html:not(.dev-borders-off) [data-dev-changed]::after {
            content: attr(data-dev-changed);
            position: absolute;
            top: -12px;
            right: 8px;
            padding: 1px 7px;
            border-radius: 999px;
            font: 600 11px/1.5 var(--font-mono);
            letter-spacing: 0.02em;
            color: #fff;
            background: light-dark(#a21caf, #c026d3);
            pointer-events: none;
            z-index: 25;
            white-space: nowrap;
            max-width: calc(100% - 16px);
            overflow: hidden;
            text-overflow: ellipsis;
          }
          .dev-review-toggle {
            position: fixed;
            right: 12px;
            bottom: calc(12px + var(--tour-bar-h, 0px));
            z-index: 60;
            padding: 5px 11px;
            border-radius: 999px;
            border: 1.5px solid light-dark(#a21caf, #e879f9);
            background: var(--card);
            color: light-dark(#86198f, #f5d0fe);
            font: 600 12px/1.3 var(--font-mono);
            cursor: pointer;
            box-shadow: 0 4px 14px rgb(0 0 0 / 0.16);
          }
          .dev-review-toggle[aria-pressed='false'] { opacity: 0.65; }
        </style>
        <button type="button" class="dev-review-toggle" data-dev-borders-toggle aria-pressed="true" hidden>Review borders: ON</button>
        <script is:inline>
          (() => {
            const btn = document.querySelector('[data-dev-borders-toggle]');
            if (!btn) return;
            const KEY = 'dev-review-borders';
            const sync = () => {
              const count = [...document.querySelectorAll('[data-dev-changed]')].filter((el) => !el.closest('[hidden]')).length;
              const off = document.documentElement.classList.contains('dev-borders-off');
              btn.hidden = count === 0;
              btn.setAttribute('aria-pressed', String(!off));
              btn.textContent = `Changed (${count}): ${off ? 'OFF' : 'ON'}`;
            };
            try { if (localStorage.getItem(KEY) === 'off') document.documentElement.classList.add('dev-borders-off'); } catch {}
            btn.addEventListener('click', () => {
              const off = document.documentElement.classList.toggle('dev-borders-off');
              try { localStorage.setItem(KEY, off ? 'off' : 'on'); } catch {}
              sync();
            });
            sync();
            // Client-mounted simulators and tab switches may change visible markers after load
            new MutationObserver(sync).observe(document.getElementById('main') || document.body, { subtree: true, childList: true, attributes: true, attributeFilter: ['data-dev-changed', 'hidden'] });
          })();
        </script>
      </>
    )}
  </body>
</html>
