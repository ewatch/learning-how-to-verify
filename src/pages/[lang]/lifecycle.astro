---
import Base from '../../layouts/Base.astro';
import type { Locale } from '../../data/types';
import { PHASES } from '../../data/taxonomy';
import { PRACTICES } from '../../data/practices';
import { href, t } from '../../i18n/ui';
import { langPaths } from '../../lib/paths';
export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Locale };
const en = lang === 'en';
const nCore = PRACTICES.filter((p) => p.core).length;
---
<Base lang={lang} path="lifecycle/" md={`/${lang}/lifecycle/index.md`} nav="lifecycle" title={en ? 'Lifecycle map' : 'Lebenszyklus'}
  description={en ? 'All verification practices by when they happen: pre-production, deploy, release, post-release.' : 'Alle Verifikationspraktiken danach, wann sie stattfinden: vor der Produktion, Deploy, Release, nach dem Release.'}>
  <div class="wrap">
    <header class="narrow">
      <p class="eyebrow">{en ? 'Second view' : 'Zweite Ansicht'}</p>
      <h1>{en ? 'When does each check happen?' : 'Wann findet welche Prüfung statt?'}</h1>
      <p class="lede">{en
        ? 'This map sorts the practices by the time when they run: before production, at deploy, at release and after release. Use it to find the checks for one stage of a change. There are bugs that appear only with real traffic, real data and real users. For this reason, the right-hand columns test in production, with care and with a small blast radius.'
        : 'Diese Karte sortiert die Praktiken nach dem Zeitpunkt: vor der Produktion, beim Deploy, beim Release und nach dem Release. Sie hilft, die Prüfungen für eine Phase einer Änderung zu finden. Es gibt Fehler, die sich erst mit echtem Verkehr, echten Daten und echten Nutzern zeigen. Deshalb testen die rechten Spalten in Produktion, vorsichtig und mit kleinem Wirkungsradius.'}</p>
      <p class="muted small">{en
        ? 'After the overview by Cindy Sridharan (@copyconstruct), as shown by Lauren Tan (@poteto). Colour bars on the left show the funnel layer.'
        : 'Nach der Übersicht von Cindy Sridharan (@copyconstruct), wie von Lauren Tan (@poteto) gezeigt. Farbbalken links zeigen die Trichterschicht.'}</p>
      <ul class="key small">
        <li><span class="core">{en ? 'core' : 'Kern'}</span> {en ? <>Core practice: one of {nCore} to start with. The <a href={href(lang, 'start/')}>Getting Started</a> tour covers most of them.</> : <>Kernpraktik: eine von {nCore} für den Anfang. Der Einstieg <a href={href(lang, 'start/')}>Erste Schritte</a> deckt die meisten ab.</>}</li>
        <li><span class="added">{en ? 'added' : 'ergänzt'}</span> {en ? 'Not in the original overview; added on this site.' : 'Nicht in der ursprünglichen Übersicht; auf dieser Seite ergänzt.'}</li>
      </ul>
    </header>

    <div class="groups" aria-hidden="true">
      <span class="g pre">{PHASES[0].group[lang]}</span>
      <span class="g prod">{PHASES[1].group[lang]}</span>
    </div>
    <div class="board">
      {PHASES.map((ph) => {
        const list = PRACTICES.filter((p) => p.phases.includes(ph.id));
        return (
          <section class="col" id={`phase-${ph.id}`} style={`--pc: var(--p-${ph.id})`}>
            <h2>{ph.name[lang]} <span class="count">{list.length}</span></h2>
            <ul>
              {list.map((p) => (
                <li class:list={{ 'is-core': p.core }} style={`--c: var(--l-${p.layer})`}>
                  <a href={href(lang, `practices/${p.id}/`)}>{p.name[lang]}</a>{p.core && <span class="core" title={t(lang, 'corePractice')}>{en ? 'core' : 'Kern'}</span>}{!p.fromOverview && <span class="added" title={t(lang, 'addedHere')}>{en ? 'added' : 'ergänzt'}</span>}
                </li>
              ))}
            </ul>
          </section>
        );
      })}
    </div>
  </div>
</Base>
<style>
  .groups { display: grid; grid-template-columns: 1.15fr 3fr; gap: 10px; margin: 34px 0 6px; font: 600 var(--fs-xs) var(--font-body); letter-spacing: .12em; text-transform: uppercase; }
  .g { border-bottom: 2px solid; padding-bottom: 6px; }
  .g.pre { color: var(--p-pre); }
  .g.prod { color: var(--ok); }
  .board { display: grid; grid-template-columns: 1.15fr 1fr 1fr 1fr; gap: 10px; }
  @media (max-width: 980px) { .board { grid-template-columns: 1fr 1fr; } .groups { display: none; } }
  @media (max-width: 560px) { .board { grid-template-columns: 1fr; } }
  .col { background: color-mix(in srgb, var(--pc) 9%, var(--card)); border: 1.5px solid var(--pc); border-radius: var(--radius); padding: 14px 14px 10px; }
  .col h2 { font-size: var(--fs-lg); display: flex; justify-content: space-between; align-items: baseline; color: var(--ink); }
  .count { font: 600 var(--fs-code) var(--font-mono); color: var(--pc); }
  ul { list-style: none; padding: 0; margin: 0; }
  li { position: relative; padding: 5px 0 5px 12px; margin: 0; border-bottom: 1px dashed color-mix(in srgb, var(--pc) 30%, transparent); }
  li:last-child { border-bottom: 0; }
  li::before { content: ''; position: absolute; left: 0; top: 9px; bottom: 9px; width: 3px; border-radius: 2px; background: var(--c); }
  li a { color: var(--ink); text-decoration: none; }
  li a:hover { text-decoration: underline; }
  li.is-core a { font-weight: 700; }
  .core, .added { display: inline-block; margin-left: 6px; font: 600 var(--fs-xs)/1.45 var(--font-body); letter-spacing: .02em; border-radius: 3px; padding: 0 5px; vertical-align: 1px; white-space: nowrap; }
  .core { background: var(--ink); color: var(--paper); border: 1px solid var(--ink); }
  .added { color: var(--ink-2); border: 1px dashed var(--rule-strong); font-weight: 500; }
  .key { list-style: none; padding: 0; margin: 10px 0 0; color: var(--ink-2); }
  .key li { padding: 0; border: 0; margin: 0 0 4px; }
  .key li::before { display: none; }
  .key a { color: var(--link); text-decoration: underline; }
  .key .core, .key .added { margin: 0 6px 0 0; }
</style>
