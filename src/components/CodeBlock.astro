---
import { t } from '../i18n/ui';
import { inline } from '../lib/inline';
import type { Locale, Focus } from '../data/types';
interface Props { code: string; file?: string; lang: Locale; id: string; focus?: Focus[] }
const { code, file, lang, id, focus } = Astro.props;
const NUMS = ['①', '②', '③', '④', '⑤', '⑥', '⑦', '⑧', '⑨'];
const lines = code.split('\n');
const range = (f: Focus): [number, number] => (Array.isArray(f.line) ? f.line : [f.line, f.line]);
// line number (1-based) -> focus index (first one wins) and which line carries the badge
const owner = new Map<number, number>();
const first = new Map<number, number>();
(focus ?? []).forEach((f, i) => {
  const [a, b] = range(f);
  first.set(a, i);
  for (let n = a; n <= b; n++) if (!owner.has(n)) owner.set(n, i);
});
const lineLabel = (f: Focus) => { const [a, b] = range(f); return a === b ? `${lang === 'de' ? 'Zeile' : 'Line'} ${a}` : `${lang === 'de' ? 'Zeilen' : 'Lines'} ${a}–${b}`; };
---
{!focus?.length ? (
  <div class="codeblock">
    <div class="head"><span>{file ?? ''}</span><button type="button" class="btn ghost sm" data-copy={id} command="--copy" commandfor={id} aria-label={file ? `${t(lang, 'copy')} ${file}` : undefined}>{t(lang, 'copy')}</button></div>
    <pre id={id} tabindex="0"><code>{code}</code></pre>
  </div>
) : (
  <div class="codeblock fc" data-fc data-total={focus.length} data-note-label={t(lang, 'noteLabel')} data-close-label={t(lang, 'closeNote')}>
    <div class="head">
      <span>{file ?? ''}</span>
      <span class="actions">
        <button type="button" class="btn ghost sm" data-fc-start hidden>{t(lang, 'walkthrough')}</button>
        <button type="button" class="btn ghost sm" data-copy={id} command="--copy" commandfor={id} aria-label={file ? `${t(lang, 'copy')} ${file}` : undefined}>{t(lang, 'copy')}</button>
      </span>
    </div>
    <pre id={id} hidden>{code}</pre>
    <pre tabindex="0" class="view" aria-label={file ?? undefined}><code>{lines.map((ln, i) => {
      const n = i + 1;
      const o = owner.get(n);
      const b = first.get(n);
      return <span class={`ln${o !== undefined ? ' f' : ''}`} data-f={o} data-n={b !== undefined ? NUMS[b] : undefined} data-b={b}>{ln}</span>;
    })}</code></pre>
    <details class="notebox">
      <summary>{t(lang, 'notes')} ({focus.length})</summary>
      <ol class="notes" aria-label={t(lang, 'whatToLookAt')}>
        {focus.map((f, i) => <li data-note={i} data-n={NUMS[i]}><span class="where">{lineLabel(f)}</span> <span set:html={inline(f.note[lang])} /></li>)}
      </ol>
    </details>
    <div class="guide" data-fc-guide hidden role="group" aria-label={t(lang, 'walkthrough')}>
      <div class="gnote" data-fc-note aria-live="polite" aria-atomic="true"></div>
      <div class="gctl">
        <button type="button" class="btn ghost sm" data-fc-prev>{t(lang, 'prevStep')}</button>
        <span class="count" data-fc-count aria-hidden="true"></span>
        <button type="button" class="btn sm" data-fc-next>{t(lang, 'nextStep')}</button>
        <button type="button" class="btn ghost sm" data-fc-close>{t(lang, 'closeWalkthrough')}</button>
      </div>
    </div>
  </div>
)}
<style>
  .actions { display: inline-flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
  .view code { display: block; width: max-content; min-width: 100%; }
  .ln { display: block; min-height: 1.5em; padding-left: 1.9em; margin-left: -12px; border-left: 3px solid transparent; position: relative; transition: opacity .2s, background-color .2s; }
  .ln.f { background: color-mix(in srgb, var(--c, var(--link)) 13%, transparent); border-left-color: var(--c, var(--link)); }
  .ln[data-n]::before { content: attr(data-n); position: absolute; left: .35em; top: 0; font-family: var(--font-sans, inherit); font-size: .95rem; line-height: 1.5; font-weight: 700; color: var(--c, var(--link)); }
  .notes { list-style: none; margin: 6px 0 0; padding: 0; display: grid; gap: 6px; font-size: .92rem; }
  .notes li { display: grid; grid-template-columns: 1.6em 1fr; column-gap: 6px; }
  .notes li::before { content: attr(data-n); font-weight: 700; color: var(--c, var(--link)); grid-row: 1; grid-column: 1; }
  .notes li > * { grid-column: 2; }
  .where { font: 500 .78rem var(--font-mono); color: var(--ink-3); }
  .guide { margin-top: 10px; padding: 10px 12px; border: 1px solid var(--rule); border-left: 3px solid var(--c, var(--link)); border-radius: var(--radius); background: var(--card); }
  .gnote { font-size: .95rem; min-height: 2.6em; }
  .gctl { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: 8px; }
  .count { font: 500 .85rem var(--font-mono); color: var(--ink-2); min-width: 3.5em; text-align: center; }
  .fc { position: relative; }
  /* with script the notes live in the badge popovers; the list stays findable (hidden=until-found) and opens on Ctrl+F */
  .notebox > summary { cursor: pointer; font-size: .88rem; color: var(--ink-2); padding: 4px 0; margin-top: 8px; }
  .notebox > summary:focus-visible { outline: 2px solid var(--link); outline-offset: 2px; }
  .fc.js .ln[data-n]::before { content: none; }
  .fc.guided :global(.badge-btn) { display: none; }
  :global(.badge-btn) { position: absolute; left: .15em; top: 0; width: 1.7em; height: 1.5em; padding: 0; border: 0; background: transparent; cursor: pointer; font: 700 .95rem/1.5 var(--font-sans, inherit); color: var(--c, var(--link)); user-select: none; border-radius: 4px; }
  :global(.badge-btn:hover), :global(.badge-btn[aria-expanded='true']) { background: color-mix(in srgb, var(--c, var(--link)) 22%, transparent); }
  :global(.badge-btn:focus-visible) { outline: 2px solid var(--link); outline-offset: -2px; }
  :global(.pop) { position: absolute; z-index: 20; box-sizing: border-box; padding: 10px 12px; background: var(--card); color: var(--ink); border: 1px solid var(--rule-strong, var(--rule)); border-left: 3px solid var(--c, var(--link)); border-radius: var(--radius); box-shadow: 0 6px 20px rgb(0 0 0 / 0.18); font-size: .92rem; line-height: 1.45; font-family: var(--font-body, inherit); white-space: normal; }
  :global(.pop[hidden]) { display: none; }
  /* native popover: top layer, light dismiss and Escape come from the browser; the badge is the implicit anchor */
  :global(.pop[popover]) { --w: min(28rem, calc(100dvw - 1rem)); position: fixed; inline-size: var(--w); margin: 0; overflow: auto; max-block-size: 60dvh; }
  @supports (top: anchor(bottom)) {
    :global(.pop[popover]) { inset: auto; top: anchor(bottom); left: max(.5rem, min(anchor(left), calc(100dvw - var(--w) - .5rem))); margin-block: 4px; position-try-fallbacks: flip-block; }
  }
  :global(.pop .where) { display: block; margin-bottom: 2px; font: 500 .78rem var(--font-mono); color: var(--ink-3); }
  .fc.guided .ln.f:not(.on), .fc.guided .ln:not(.f) { opacity: .4; }
  .fc.guided .ln.f:not(.on) { background: transparent; border-left-color: transparent; }
  .fc.guided .ln.on { background: color-mix(in srgb, var(--c, var(--link)) 24%, transparent); }
  @media (prefers-reduced-motion: reduce) { .ln { transition: none; } }
</style>
<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-fc]')) {
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const start = $<HTMLButtonElement>('[data-fc-start]');
    const guide = $('[data-fc-guide]');
    const noteEl = $('[data-fc-note]');
    const count = $('[data-fc-count]');
    const prev = $<HTMLButtonElement>('[data-fc-prev]');
    const next = $<HTMLButtonElement>('[data-fc-next]');
    const notes = [...root.querySelectorAll<HTMLElement>('[data-note]')];
    const total = notes.length;
    const of = document.documentElement.lang === 'de' ? 'von' : 'of';
    let step = 0;
    root.classList.add('js');
    // the plain notes list moves behind find-in-page: hidden until Ctrl+F matches it (browsers without until-found just hide it)
    const notebox = $<HTMLDetailsElement>('.notebox');
    notebox.setAttribute('hidden', 'until-found');
    const nativePopover = 'popover' in HTMLElement.prototype;
    const anchored = CSS.supports('top', 'anchor(bottom)');
    // Note popovers anchored at the marked line
    const pops: HTMLElement[] = [];
    const btns: HTMLButtonElement[] = [];
    const isOpen = (i: number) => (nativePopover ? pops[i]!.matches(':popover-open') : !pops[i]!.hidden);
    const closePops = (refocus = false) => {
      pops.forEach((p, i) => {
        if (!isOpen(i)) return;
        if (nativePopover) p.hidePopover(); else { p.hidden = true; btns[i]!.setAttribute('aria-expanded', 'false'); }
        if (refocus) btns[i]!.focus();
      });
    };
    // positioning for browsers without anchor() (and without native popover): same rule as the CSS
    const place = (i: number) => {
      const p = pops[i]!, b = btns[i]!;
      const br = b.getBoundingClientRect();
      const rr = root.getBoundingClientRect(), lr = (b.closest('.ln') as HTMLElement).getBoundingClientRect();
      if (nativePopover) {
        const w = Math.min(448, innerWidth - 16);
        p.style.inset = 'auto'; p.style.margin = '0'; p.style.width = w + 'px';
        p.style.left = Math.max(8, Math.min(br.left, innerWidth - w - 8)) + 'px';
        const h = p.offsetHeight, below = lr.bottom + 4;
        p.style.top = (below + h > innerHeight && lr.top - h - 4 > 0 ? lr.top - h - 4 : below) + 'px';
      } else {
        const w = Math.min(448, rr.width - 16);
        p.style.width = w + 'px';
        p.style.left = Math.max(8, Math.min(br.left - rr.left, rr.width - w - 8)) + 'px';
        p.style.top = lr.bottom - rr.top + 4 + 'px';
      }
    };
    notes.forEach((li, i) => {
      const line = root.querySelector<HTMLElement>(`.ln[data-b="${i}"]`);
      if (!line) return;
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'badge-btn';
      b.textContent = li.dataset.n ?? String(i + 1);
      b.setAttribute('aria-label', `${root.dataset.noteLabel} ${i + 1}`);
      b.setAttribute('aria-expanded', 'false');
      const id = `${root.querySelector('pre[id]')!.id}-pop-${i}`;
      b.setAttribute('aria-controls', id);
      line.appendChild(b);
      const pop = document.createElement('div');
      pop.className = 'pop'; pop.id = id;
      pop.setAttribute('role', 'group');
      pop.setAttribute('aria-label', `${root.dataset.noteLabel} ${i + 1}`);
      pop.innerHTML = li.innerHTML;
      root.appendChild(pop);
      pops[i] = pop; btns[i] = b;
      if (nativePopover) {
        // declarative: the button opens/closes the popover; Escape, outside click and focus return are native
        pop.setAttribute('popover', 'auto');
        b.setAttribute('popovertarget', id);
        // explicit anchor: the implicit popovertarget anchor is not honoured for anchor() everywhere (and not by the polyfill)
        if (anchored) { b.style.setProperty('anchor-name', `--${id}`); pop.style.setProperty('position-anchor', `--${id}`); }
        pop.addEventListener('beforetoggle', (e) => { if ((e as ToggleEvent).newState === 'open' && !anchored) place(i); });
        // aria-expanded follows the popover (the source of truth); toggle does not bubble, so listen on the popover
        pop.addEventListener('toggle', (e) => b.setAttribute('aria-expanded', String((e as ToggleEvent).newState === 'open')));
      } else {
        pop.hidden = true;
        b.addEventListener('click', (e) => {
          e.stopPropagation();
          const wasOpen = !pop.hidden;
          closePops();
          if (!wasOpen) { pop.hidden = false; b.setAttribute('aria-expanded', 'true'); place(i); }
        });
      }
    });
    if (!nativePopover) document.addEventListener('click', (e) => { if (!(e.target as Element).closest('.pop')) closePops(); });
    window.addEventListener('resize', () => pops.forEach((_, i) => { if (isOpen(i)) place(i); }));
    const show = () => {
      root.querySelectorAll('.ln').forEach((l) => l.classList.toggle('on', (l as HTMLElement).dataset.f === String(step)));
      noteEl.innerHTML = notes[step].innerHTML;
      count.textContent = `${step + 1} / ${total}`;
      count.setAttribute('aria-label', `${step + 1} ${of} ${total}`);
      prev.disabled = step === 0;
      next.disabled = step === total - 1;
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      root.querySelector('.ln.on')?.scrollIntoView({ block: 'nearest', behavior: reduce ? 'auto' : 'smooth' });
    };
    const open = () => { closePops(); notebox.open = false; notebox.setAttribute('hidden', 'until-found'); root.classList.add('guided'); guide.hidden = false; start.setAttribute('aria-expanded', 'true'); step = 0; show(); next.focus(); };
    const close = () => { root.classList.remove('guided'); guide.hidden = true; start.setAttribute('aria-expanded', 'false'); root.querySelectorAll('.ln.on').forEach((l) => l.classList.remove('on')); start.focus(); };
    start.hidden = false;
    start.setAttribute('aria-expanded', 'false');
    start.addEventListener('click', open);
    prev.addEventListener('click', () => { if (step > 0) { step--; show(); } });
    next.addEventListener('click', () => { if (step < total - 1) { step++; show(); } });
    $('[data-fc-close]').addEventListener('click', close);
    root.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (!nativePopover && pops.some((_, i) => isOpen(i))) { e.stopPropagation(); closePops(true); return; }
      // native popovers close themselves on Escape; the walkthrough only closes when none was open
      if (root.classList.contains('guided') && !pops.some((_, i) => isOpen(i))) { e.stopPropagation(); close(); }
    });
  }
</script>
