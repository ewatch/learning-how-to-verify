{
  "name": "petstore",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web \"tsx watch server/main.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "generate:api": "openapi-typescript openapi.yaml -o src/api/schema.d.ts",
    "test": "vitest run",
    "test:property": "vitest run test/property",
    "test:differential": "npm run -s verify:dafny && vitest run test/differential",
    "test:differential:live": "tsx scripts/diff-live.ts",
    "test:mutation": "stryker run",
    "fuzz": "node scripts/fuzz.mjs",
    "verify:dafny": "./scripts/verify-dafny.sh",
    "verify:tla": "./scripts/verify-tla.sh",
    "showcase": "tsx showcase/run.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hono/node-server": "^2.1.5",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "hono": "^4.13.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jazzer.js/core": "^4.0.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "bignumber.js": "^11.1.5",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
