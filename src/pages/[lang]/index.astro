---
import Base from '../../layouts/Base.astro';
import Funnel from '../../components/Funnel.astro';
import type { Locale } from '../../data/types';
import { href } from '../../i18n/ui';
import { BASE } from '../../lib/site';
import { PRACTICES } from '../../data/practices';
import { langPaths } from '../../lib/paths';
import { START_TOUR } from '../../data/start';
import { HOME } from '../../data/home';
import { PETSTORE_COPY } from '../../data/petstore';
import { devMark } from '../../lib/dev-mark';
export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Locale };
const en = lang === 'en';
const n = PRACTICES.length;
const steps = START_TOUR.length;
const sims = new Set(PRACTICES.map((p) => p.sim).filter(Boolean)).size;
---
<Base lang={lang} path="" md={`/${lang}/index.md`} nav="funnel"
  title={en ? 'Learning how to verify' : 'Verifizieren lernen'}
  description={HOME.lead[lang]}>
  <div class="wrap">
    <section class="hero" {...devMark('tighter hero copy')}>
      <p class="eyebrow">{en ? `${n} practices · ${sims} simulators in your browser · English & Deutsch` : `${n} Praktiken · ${sims} Simulatoren im Browser · Deutsch & English`}</p>
      <h1>{HOME.headline[lang]}</h1>
      <p class="lede">{HOME.lead[lang]}</p>
      <div class="cta">
        <a class="btn primary" href={href(lang, 'start/')}>{HOME.start[lang](steps)} <span aria-hidden="true">→</span></a>
        <a class="secondary" href="#funnel">{HOME.overview[lang]} <span aria-hidden="true">↓</span></a>
      </div>
    </section>

    <section id="funnel" class="map" aria-labelledby="funnel-title" {...devMark('shorter funnel intro')}>
      <h2 id="funnel-title">{HOME.funnelTitle[lang]}</h2>
      <p class="intro">{HOME.funnelIntro[lang]}</p>
      <Funnel lang={lang} />
    </section>

    <section class="ways" {...devMark('tighter card copy')}>
      <h2>{HOME.waysTitle[lang]}</h2>
      <div class="grid cols-2">
        <a class="way card" href={href(lang, 'diagnose/')}><strong>{HOME.diagnoseTitle[lang]} →</strong><span>{HOME.diagnose[lang]}</span></a>
        <a class="way card" href={href(lang, 'lifecycle/')}><strong>{en ? 'Lifecycle map →' : 'Lebenszyklus →'}</strong><span>{HOME.lifecycle[lang]}</span></a>
        <a class="way card" href={href(lang, 'stack/')}><strong>{'Tech Stack →'}</strong><span>{HOME.stack[lang]}</span></a>
        <a class="way card" href={href(lang, 'petstore/')}><strong>{PETSTORE_COPY.open[lang]} →</strong><span>{PETSTORE_COPY.homeWay[lang]}</span></a>
      </div>
    </section>

    <aside class="honest card" aria-label={HOME.evidenceTitle[lang]} {...devMark('halved evidence note')}>
      <h2>{HOME.evidenceTitle[lang]}</h2>
      <p>{HOME.evidence[lang]}</p>
      <p><a href={href(lang, 'why-layers/')}>{HOME.whyLayers[lang]} <span aria-hidden="true">→</span></a></p>
    </aside>

    <aside class="agents" aria-label={HOME.forAgents[lang]} {...devMark('1-line agents note')}>
      <p class="eyebrow">{HOME.forAgents[lang]}</p>
      <p>{HOME.giveAgent[lang]} <a href={`${BASE}/llms.txt`}><code>/llms.txt</code></a>{HOME.appendMarkdown[lang]} <code>index.md</code> {HOME.markdownEnd[lang]}</p>
    </aside>
  </div>
</Base>

<style>
  .hero { padding: 18px 0 40px; max-width: 46rem; }
  .hero h1 { margin-bottom: 18px; }
  .hero .lede { max-width: 42rem; }
  .cta { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 22px; margin-top: 26px; }
  .btn.primary { font-size: var(--fs-body); font-weight: 700; padding: 12px 20px; }
  .secondary { color: var(--ink-2); }
  .secondary:hover { color: var(--ink); }
  .map { padding-top: 30px; border-top: 1px solid var(--rule); scroll-margin-top: 4.5rem; }
  .map > h2 { margin-bottom: 8px; }
  .intro { color: var(--ink-2); max-width: 42rem; margin-bottom: 22px; }
  .ways { margin-top: 56px; }
  /* four doors: two by two, never three plus one */
  .ways .grid { grid-template-columns: repeat(2, 1fr); }
  @media (max-width: 640px) { .ways .grid { grid-template-columns: 1fr; } }
  .way { display: flex; flex-direction: column; gap: 6px; text-decoration: none; color: var(--ink); }
  .way span { color: var(--ink-2); font-size: var(--fs-ui); }
  .way:hover { border-color: var(--rule-strong); }
  .honest { margin-top: 40px; max-width: 50rem; border-left: 4px solid var(--warn); }
  .agents { margin-top: 28px; max-width: 50rem; color: var(--ink-2); }
</style>
